# Variables here are read by the Node server only. Browser-exposed ones would need a VITE_ prefix (none are used today).
# Values left as the placeholders below are treated as missing.
# Copy to .env.local. All variables are optional: the app runs on curated/synthesized data without them.
# (See ARCHITECTURE.md §2 for exactly which code reads each variable.)

# PORT: HTTP port for server.ts (default 3000)
# PORT=3000

# Live fares: the "Fetch Live Fares" button on a leg (and "Book Exact Ticket" on a card) spends SerpApi
# searches. Nothing is ever fetched on page load or on an edit. USE_REAL_DATA=false switches the button
# off (estimated schedule + exact-route search links only). The default lives in shared/config.ts
# (USE_REAL_TICKET_DATA); this variable overrides it per environment, e.g. on Vercel.
# USE_REAL_DATA=true

# SerpApi (https://serpapi.com): Google Flights fares and the sellers of one exact ticket, plus live
# hotels. The free plan has 100 searches a month. Server-side only, never expose it to the browser.
# (SERPAPI_KEY, this project's old name for it, still works.)
SERPAPI_API_KEY="your-serpapi-api-key"

# Free Aviasales Data API (Travelpayouts): in sample mode, flights show real recent fares (seen on
# Aviasales in the last ~48 h) instead of invented ones; routes it has no data for stay sample data.
# Token: Travelpayouts -> Profile -> API token. Marker (optional): your partner id, adds attribution
# to the Aviasales links.
TRAVELPAYOUTS_TOKEN="your-travelpayouts-token"
# TRAVELPAYOUTS_MARKER="806003"   (default in shared/config.ts: AFFILIATE_DEFAULTS)

# Google Routes API: real public-transport directions (lines, operators, stops, times, fare, map
# lines) for a leg's "Schedules" panel. Paid per request past Google's free allowance, so it is only
# called when a leg is opened and answers are cached 7 days. Server-side only; restrict the key to
# the Routes API in Google Cloud. Without it the panel shows the 12Go timetable only.
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Upstash Redis: 12-hour cache for transit queries (EX: 43200)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Partner ids for the direct merchant links (shared/affiliate.ts). All optional: without an id the
# link still opens the exact search on the merchant's site, it just earns no commission.
# Trip.com (flights, trains, hotels): sent as Allianceid, SID and trip_sub3. All three default to the values in
# shared/config.ts (AFFILIATE_DEFAULTS), so links are attributed without any setup; set these only to override.
# VITE_TRIP_ALLIANCE_ID and VITE_TRIP_SID are accepted as alternative names.
# TRIPCOM_ALLIANCE_ID="11395112"
# TRIPCOM_SID="336262403"
# TRIPCOM_SUB3="D21235867"
# Stays -> Booking.com (sent as aid) and Agoda (sent as cid)
BOOKING_AID="your-booking-affiliate-id"
AGODA_CID="your-agoda-cid"
# Trains, ferries and non-FlixBus coaches -> 12Go (sent as z)
# TWELVEGO_AFFILIATE_ID="17520220"   (default in shared/config.ts: AFFILIATE_DEFAULTS)

# Programs that run through an affiliate network (FlixBus on Awin, or any merchant via
# Travelpayouts / CJ / Impact) use a tracking template instead: {url} is replaced with the
# URL-encoded deep link, so the click still lands on the exact merchant page.
# FLIXBUS_TRACKING_TEMPLATE="https://www.awin1.com/cread.php?awinmid=MERCHANT&awinaffid=YOU&ued={url}"
# TRIPCOM_TRACKING_TEMPLATE=""   BOOKING_TRACKING_TEMPLATE=""   AGODA_TRACKING_TEMPLATE=""   TWELVEGO_TRACKING_TEMPLATE=""

# FlixBus links need FlixBus's own city ids, looked up from flixbus.com's public city search.
# Set to "off" to stop those calls (FlixBus coaches then link to 12Go instead).
# FLIXBUS_CITY_LOOKUP="on"

# Accounts + cross-device route sync (Supabase free tier). Optional: without them the app is guest-only
# (routes still persist in localStorage and the "Copy route sync link" button still works), and no
# login prompts are shown. Run supabase/migrations/001_saved_routes.sql once, enable the Google and
# Email providers in Supabase Auth, and add <APP_URL>/api/auth/callback to Auth -> URL Configuration
# -> Redirect URLs. The anon/publishable key is used SERVER-SIDE only (the browser never talks to
# Supabase directly; sessions are HttpOnly cookies). Never set SUPABASE_SERVICE_ROLE_KEY: nothing uses it.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Public site URL, used for OAuth / magic-link redirects and as an allowed CORS origin.
# APP_URL="https://astris.example.com"
# Extra origins allowed to call the API cross-origin (comma-separated). Never "*".
# ALLOWED_ORIGINS="https://www.astris.example.com"
