# Copy to .env.local. All variables are optional: the app runs on curated/synthesized data without them.
# (See ARCHITECTURE.md §2 for exactly which code reads each variable.)

# PORT: HTTP port for server.ts (default 3000)
# PORT=3000

# Live Transit API: SerpApi key for Google Flights (engine=google_flights)
SERPAPI_KEY="your-serpapi-key"

# Upstash Redis: 12-hour cache for transit queries (EX: 43200)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Travelpayouts affiliate attribution for outbound booking links (shared/affiliate.ts).
# Without a marker, links still work but earn no commission.
TRAVELPAYOUTS_MARKER="your-travelpayouts-marker"
# TRAVELPAYOUTS_TRS="your-traffic-source-id"
# Aviasales defaults shown; verify in your Travelpayouts dashboard before overriding.
# TRAVELPAYOUTS_CAMPAIGN_ID="100"
# TRAVELPAYOUTS_PROGRAM_ID="4114"

# Phase 2 (NOT read by any code yet): Duffel native flight offers & order creation
# DUFFEL_ACCESS_TOKEN="your-duffel-access-token"

# AI Studio scaffolding (NOT read by any code today)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
