              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    - **Semantic Status**: Green (`#16A34A`) for savings/applied vouchers, Amber (`#D97706`) for long layovers, Crimson (`#DC2626`) for invalid vouchers or warnings\342\200\224always paired with explicit text labels."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
