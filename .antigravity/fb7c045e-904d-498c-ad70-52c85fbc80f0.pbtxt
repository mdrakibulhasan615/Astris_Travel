    content: "{\n  \"name\": \"maplibre-gl\",\n  \"description\": \"BSD licensed community fork of mapbox-gl, a WebGL interactive maps library\",\n  \"version\": \"6.18.0\",\n  \"module\": \"dist/maplibre-gl.mjs\",\n  \"style\": \"dist/maplibre-gl.css\",\n  \"license\": \"BSD-3-Clause\",\n  \"homepage\": \"https://maplibre.org/\",\n  \"funding\": \"https://github.com/maplibre/maplibre-gl-js?sponsor=1\",\n  \"bugs\": {\n    \"url\": \"https://github.com/maplibre/maplibre-gl-js/issues/\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/maplibre/maplibre-gl-js\"\n  },\n  \"types\": \"dist/maplibre-gl.d.ts\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/maplibre-gl.d.ts\",\n      \"import\": \"./dist/maplibre-gl.mjs\"\n    },\n    \"./dist/*\": \"./dist/*\",\n    \"./package.json\": \"./package.json\"\n  },\n  \"sideEffects\": [\n    \"*.css\",\n    \"src/**/*.ts\"\n  ],\n  \"dependencies\": {\n    \"@mapbox/point-geometry\": \"^1.1.0\",\n    \"@mapbox/tiny-sdf\": \"^2.3.0\",\n    \"@mapbox/unitbezier\": \"^1.0.0\",\n    \"@mapbox/vector-tile\": \"^3.0.0\",\n    \"@maplibre/geojson-vt\": \"^6.3.0\",\n    \"@maplibre/maplibre-gl-style-spec\": \"^26.6.0\",\n    \"@maplibre/mlt\": \"^1.3.0\",\n    \"@maplibre/vt-pbf\": \"^4.3.3\",\n    \"@types/geojson\": \"^7946.0.16\",\n    \"bidi-js\": \"^1.1.0\",\n    \"earcut\": \"^3.2.4\",\n    \"gl-matrix\": \"^3.4.4\",\n    \"kdbush\": \"^4.1.0\",\n    \"murmurhash-js\": \"^1.0.0\",\n    \"pbf\": \"^5.1.2\",\n    \"potpack\": \"^2.1.0\",\n    \"quickselect\": \"^3.0.0\",\n    \"tinyqueue\": \"^3.0.0\"\n  },\n  \"devDependencies\": {\n    \"@fontsource/noto-sans-devanagari\": \"^5.3.0\",\n    \"@fontsource/noto-sans-hebrew\": \"^5.3.0\",\n    \"@fontsource/noto-sans-khmer\": \"^5.3.0\",\n    \"@fontsource/noto-sans-myanmar\": \"^5.3.0\",\n    \"@fontsource/noto-sans-thai\": \"^5.3.0\",\n    \"@mapbox/mvt-fixtures\": \"^4.0.0\",\n    \"@stylistic/eslint-plugi