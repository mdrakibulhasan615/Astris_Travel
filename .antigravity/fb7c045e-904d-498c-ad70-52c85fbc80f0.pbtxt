    content: "\t} catch {\n\t\treturn false;\n\t}\n}\n/**\n* The URL of the worker bundle next to this module, carrying the package version as a `v` query\n* parameter so that a browser does not serve a worker cached from an older release.\n*/\nfunction defaultWorkerUrl() {\n\tconst moduleUrl = import.meta.url;\n\tif (!/^https?:/.test(moduleUrl)) return \"\";\n\tconst workerName = moduleUrl.endsWith(\"-dev.mjs\") ? \"maplibre-gl-worker-dev.mjs\" : \"maplibre-gl-worker.mjs\";\n\tconst url = new URL(`./${workerName}`, moduleUrl);\n\turl.searchParams.set(\"v\", version$2);\n\treturn url.href;\n}\nfunction isClassicWorkerUrl(url) {\n\treturn url.endsWith(\".cjs\") || url.split(/[?#]/)[0].endsWith(\".cjs\");\n}\nfunction createWorker(url, asModule) {\n\tif (asModule) try {\n\t\treturn new Worker(url, { type: \"module\" });\n\t} catch (e) {\n\t\tconsole.warn(\"Module worker not supported, falling back to classic worker\", e);\n\t}\n\treturn new Worker(url);\n}\nasync function fetchWorkerCode(url) {\n\tconst response = await fetch(url);\n\tif (!response.ok) throw new Error(`Failed to fetch worker script (${response.status}): ${url}`);\n\treturn response.text();\n}\nasync function fetchAsBlobUrl(url) {\n\tconst blob = new Blob([await fetchWorkerCode(url)], { type: \"text/javascript\" });\n\treturn URL.createObjectURL(blob);\n}\nfunction hasOpaqueOrigin() {\n\treturn globalThis.origin === \"null\";\n}\n/**\n* On a page with an opaque origin, Chrome doesn\'t start a module worker from a `blob:` URL, https://issues.chromium.org/issues/40067939"
