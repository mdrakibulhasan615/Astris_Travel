  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n@import \"maplibre-gl/dist/maplibre-gl.css\";\n\n@layer base {\n  :root {\n    --font-display: \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, sans-serif;\n    --font-body: \"DM Sans\", -apple-system, BlinkMacSystemFont, sans-serif;\n    --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n    --astris-accent: #FF812E;\n    --astris-accent-hover: #E56B1A;\n    --astris-tint: #FFF4ED;\n    --astris-tint-border: #FFD6BA;\n  }\n\n  body {\n    font-family: var(--font-body);\n    background-color: #FAFAFA;\n    color: #111827;\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: var(--font-display);\n    text-wrap: balance;\n  }\n\n  .font-mono, .tabular-nums {\n    font-variant-numeric: tabular-nums;\n  }\n}\n\n/* Custom MapLibre marker & popup reset */\n.maplibregl-popup-content {\n  border-radius: 14px;\n  padding: 10px 14px;\n  box-shadow: 0 10px 25px -5px rgba(17, 24, 39, 0.14);\n  border: 1px solid rgba(229, 231, 235, 0.9);\n  font-family: var(--font-body);\n}\n\n.maplibregl-ctrl-group {\n  border-radius: 12px !important;\n  border: 1px solid rgba(229, 231, 235, 0.9) !important;\n  box-shadow: 0 4px 14px rgba(17, 24, 39, 0.08) !important;\n  overflow: hidden;\n}\n\n/* Custom sleek scrollbar for left itinerary pane */\n.astris-scroll::-webkit-scrollbar {\n  width: 6px;\n}\n\n.astris-scroll::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.astris-scroll::-webkit-scrollbar-thumb {\n  background-color: rgba(156, 163, 175, 0.35);\n  border-radius: 9999px;\n}\n\n.astris-scroll::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(107, 114, 128, 0.55);\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
