    tool_calls {
      id: "call_6611747576642179685"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState } from \'react\';\\nimport { ChevronDown, ChevronUp, SlidersHorizontal } from \'lucide-react\';\\nimport { VTTS_PRESETS } from \'../../shared/smartScore.ts\';\\nimport type { VttsTier } from \'../../shared/types.ts\';\\n\\ninterface VttsControlPanelProps {\\n  vttsTier: VttsTier;\\n  hourlyTimeValue: number;\\n  totalCostUsd: number;\\n  totalSavingsUsd: number;\\n  totalHours: number;\\n  totalSmartScore: number;\\n  totalDistanceKm: number;\\n  onSelectPreset: (tier: Exclude<VttsTier, \'custom\'>, hourlyRateUsd: number) => void;\\n  onChangeCustomRate: (hourlyRateUsd: number) => void;\\n}\\n\\nexport function VttsControlPanel({\\n  vttsTier,\\n  hourlyTimeValue,\\n  totalCostUsd,\\n  totalSavingsUsd,\\n  totalHours,\\n  totalSmartScore,\\n  totalDistanceKm,\\n  onSelectPreset,\\n  onChangeCustomRate,\\n}: VttsControlPanelProps) {\\n  const [showAdvancedSlider, setShowAdvancedSlider] = useState(false);\\n\\n  return (\\n    <section\\n      aria-label=\\\"Trip summary and VTTS controls\\\"\\n      className=\\\"bg-white rounded-2xl border border-neutral-200/80 shadow-sm p-4 space-y-3.5\\\"\\n    >\\n      {/* Compact tabular KPI strip */}\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3 pb-3.5 border-b border-neutral-100\\\">\\n        <div>\\n          <div className=\\\"text-[11px] font-medium text-[#4B5563]\\\">Net Fare</div>\\n          <div className=\\\"mt-0.5 flex items-baseline gap-1.5\\\">\\n            <span className=\\\"font-display text-lg font-bold text-[#111827] tabular-nums\\\">\\n              ${totalCostUsd.toFixed(0)}\\n            </span>\\n            {totalSavingsUsd > 0 && (\\n              <span className=\\\"text-[11px] font-medium text-[#16A34A] tabular-nums\\\">\\n                -${totalSavingsUsd.toFixed(0)}\\n              </span>\\n            )}\\n          </div>\\n        </div>\\n\\n        <div>\\n          <div className=\\\"text-[11px] font-medium text-[#4B5563]\\\">Transit Time</div>\\n          <div className=\\\"mt-0.5 font-display text-lg font-bold text-[#111827] tabular-nums\\\">\\n            {totalHours.toFixed(1)}h\\n          </div>\\n        </div>\\n\\n        <div>\\n          <div className=\\\"text-[11px] font-medium text-[#4B5563]\\\">Smart Score</div>\\n          <div className=\\\"mt-0.5 font-display text-lg font-bold text-[#E56B1A] tabular-nums\\\">\\n            ${totalSmartScore.toFixed(0)}\\n          </div>\\n        </div>\\n\\n        <div>\\n          <div className=\\\"text-[11px] font-medium text-[#4B5563]\\\">Distance</div>\\n          <div className=\\\"mt-0.5 font-display text-lg font-bold text-[#111827] tabular-nums\\\">\\n            {totalDistanceKm.toLocaleString()} km\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Tiered VTTS Controls */}\\n      <div className=\\\"space-y-2.5\\\">\\n        <div className=\\\"flex items-center justify-between gap-2\\\">\\n          <h2 className=\\\"font-display text-xs font-semibold text-[#111827]\\\">\\n            VTTS Time Valuation\\n          </h2>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowAdvancedSlider((prev) => !prev)}\\n            className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-[#4B5563] hover:text-[#111827] px-2 py-1 rounded-lg hover:bg-neutral-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            <SlidersHorizontal className=\\\"w-3.5 h-3.5\\\" />\\n            <span className=\\\"font-mono tabular-nums\\\">${hourlyTimeValue}/hr</span>\\n            {showAdvancedSlider ? (\\n              <ChevronUp className=\\\"w-3.5 h-3.5\\\" />\\n            ) : (\\n              <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n            )}\\n          </button>\\n        </div>\\n\\n        <div\\n          role=\\\"radiogroup\\\"\\n          aria-label=\\\"VTTS traveler tier preset\\\"\\n          className=\\\"grid grid-cols-3 gap-1.5 p-1 bg-neutral-100 rounded-xl\\\"\\n        >\\n          {VTTS_PRESETS.map((preset) => {\\n            const isActive = vttsTier === preset.id;\\n            return (\\n              <button\\n                key={preset.id}\\n                type=\\\"button\\\"\\n                role=\\\"radio\\\"\\n                aria-checked={isActive}\\n                onClick={() => onSelectPreset(preset.id, preset.hourlyRateUsd)}\\n                className={`px-3 py-1.5 rounded-lg text-left transition-all cursor-pointer ${\\n                  isActive\\n                    ? \'bg-[#FFF4ED] border border-[#FFD6BA] shadow-sm text-[#111827]\'\\n                    : \'border border-transparent text-[#4B5563] hover:text-[#111827] hover:bg-white/60\'\\n                }`}\\n              >\\n                <div className=\\\"text-xs font-semibold truncate\\\">{preset.label}</div>\\n                <div\\n                  className={`font-mono text-[11px] tabular-nums ${\\n                    isActive ? \'text-[#E56B1A] font-semibold\' : \'text-[#4B5563]\'\\n                  }`}\\n                >\\n                  ${preset.hourlyRateUsd}/hr\\n                </div>\\n              </button>\\n            );\\n          })}\\n        </div>\\n\\n        {showAdvancedSlider && (\\n          <div className=\\\"pt-2 space-y-1.5 border-t border-neutral-100\\\">\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"vtts-advanced-slider\\\" className=\\\"font-medium text-[#111827]\\\">\\n                Custom Rate\\n              </label>\\n              <span className=\\\"font-mono font-semibold text-[#E56B1A] tabular-nums\\\">\\n                ${hourlyTimeValue}/hr\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"vtts-advanced-slider\\\"\\n              type=\\\"range\\\"\\n              min={0}\\n              max={80}\\n              step={1}\\n              value={hourlyTimeValue}\\n              onChange={(e) => onChangeCustomRate(Number(e.target.value))}\\n              className=\\\"w-full accent-[#FF812E] cursor-pointer\\\"\\n            />\\n          </div>\\n        )}\\n      </div>\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Audit and streamline VttsControlPanel removing descriptive blurbs and tutorial text for a clean high-density SaaS card.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/VttsControlPanel.tsx\", \"toolAction\":\"Streamlining VttsControlPanel UI text\", \"toolSummary\":\"Streamline VttsControlPanel.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6611747576642179346"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useSortable } from \'@dnd-kit/sortable\';\\nimport { CSS } from \'@dnd-kit/utilities\';\\nimport { GripVertical, Minus, Plus, Trash2 } from \'lucide-react\';\\nimport type { TripStop } from \'../../shared/types.ts\';\\n\\ninterface SortableStopCardProps {\\n  stop: TripStop;\\n  index: number;\\n  isHovered: boolean;\\n  canRemove: boolean;\\n  onHoverStop: (stopId: string | null) => void;\\n  onFocusStop: (stop: TripStop) => void;\\n  onUpdateNights: (stopId: string, delta: number) => void;\\n  onRemoveStop: (stopId: string) => void;\\n}\\n\\nexport function SortableStopCard({\\n  stop,\\n  index,\\n  isHovered,\\n  canRemove,\\n  onHoverStop,\\n  onFocusStop,\\n  onUpdateNights,\\n  onRemoveStop,\\n}: SortableStopCardProps) {\\n  const { attributes, listeners, setNodeRef, transform, transition, isDragging } =\\n    useSortable({ id: stop.id });\\n\\n  const style = {\\n    transform: CSS.Transform.toString(transform),\\n    transition,\\n  };\\n\\n  return (\\n    <div\\n      ref={setNodeRef}\\n      style={style}\\n      onMouseEnter={() => onHoverStop(stop.id)}\\n      onMouseLeave={() => onHoverStop(null)}\\n      className={`rounded-2xl bg-white border px-4 py-3 transition-all ${\\n        isDragging\\n          ? \'opacity-80 shadow-lg border-[#FF812E] z-20\'\\n          : isHovered\\n            ? \'border-[#FFD6BA] bg-[#FFF4ED]/40 shadow-md\'\\n            : \'border-neutral-200/80 shadow-sm hover:shadow-md\'\\n      }`}\\n    >\\n      <div className=\\\"flex items-center justify-between gap-3\\\">\\n        <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={`Reorder ${stop.city}`}\\n            {...attributes}\\n            {...listeners}\\n            className=\\\"p-1 -ml-1 rounded-lg text-neutral-400 hover:text-[#111827] hover:bg-neutral-100 cursor-grab active:cursor-grabbing focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF812E]\\\"\\n          >\\n            <GripVertical className=\\\"w-4 h-4\\\" />\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onFocusStop(stop)}\\n            className=\\\"w-7 h-7 rounded-full bg-[#FF812E] text-white font-display text-xs font-bold flex items-center justify-center shrink-0 ring-2 ring-white shadow-sm hover:bg-[#E56B1A] transition-colors cursor-pointer\\\"\\n          >\\n            {index + 1}\\n          </button>\\n\\n          <div className=\\\"min-w-0\\\">\\n            <div className=\\\"flex flex-wrap items-baseline gap-x-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onFocusStop(stop)}\\n                className=\\\"font-display text-sm font-bold text-[#111827] hover:text-[#E56B1A] transition-colors text-left cursor-pointer\\\"\\n              >\\n                {stop.city}\\n              </button>\\n              <span className=\\\"text-xs text-[#4B5563] truncate\\\">\\n                {stop.country} \302\267 <span className=\\\"font-mono\\\">{stop.iataCode}</span>\\n              </span>\\n            </div>\\n\\n            <div className=\\\"mt-0.5 flex flex-wrap items-center gap-x-2 text-[11px] font-mono text-[#4B5563] tabular-nums\\\">\\n              <span>\\n                {stop.arrivalDate} \342\206\222 {stop.departureDate}\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                {stop.lat.toFixed(2)}, {stop.lng.toFixed(2)}\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-1.5 shrink-0\\\">\\n          <div className=\\\"inline-flex items-center rounded-xl border border-neutral-200 bg-neutral-50/70 p-0.5\\\">\\n            <button\\n              type=\\\"button\\\"\\n              aria-label={`Decrease nights in ${stop.city}`}\\n              onClick={() => onUpdateNights(stop.id, -1)}\\n              disabled={stop.stayNights <= 1}\\n              className=\\\"w-6 h-6 flex items-center justify-center rounded-lg text-[#4B5563] hover:text-[#111827] hover:bg-white disabled:opacity-40 transition-colors cursor-pointer\\\"\\n            >\\n              <Minus className=\\\"w-3 h-3\\\" />\\n            </button>\\n            <span className=\\\"px-2 font-mono text-xs font-semibold text-[#111827] tabular-nums whitespace-nowrap\\\">\\n              {stop.stayNights}n\\n            </span>\\n            <button\\n              type=\\\"button\\\"\\n              aria-label={`Increase nights in ${stop.city}`}\\n              onClick={() => onUpdateNights(stop.id, 1)}\\n              className=\\\"w-6 h-6 flex items-center justify-center rounded-lg text-[#4B5563] hover:text-[#111827] hover:bg-white transition-colors cursor-pointer\\\"\\n            >\\n              <Plus className=\\\"w-3 h-3\\\" />\\n            </button>\\n          </div>\\n\\n          {canRemove && (\\n            <button\\n              type=\\\"button\\\"\\n              aria-label={`Remove ${stop.city}`}\\n              onClick={() => onRemoveStop(stop.id)}\\n              className=\\\"w-7 h-7 flex items-center justify-center rounded-xl text-neutral-400 hover:text-[#DC2626] hover:bg-red-50 transition-colors cursor-pointer\\\"\\n            >\\n              <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Streamline SortableStopCard removing descriptive notes text for crisp high-density SaaS card layout.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SortableStopCard.tsx\", \"toolAction\":\"Streamlining SortableStopCard UI text\", \"toolSummary\":\"Streamline SortableStopCard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6611747576642183103"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Bus,\\n  Check,\\n  ChevronDown,\\n  ChevronUp,\\n  Moon,\\n  Plane,\\n  Ship,\\n  TrainFront,\\n} from \'lucide-react\';\\nimport { formatDuration } from \'../../shared/smartScore.ts\';\\nimport type { ModeFilter, TransitMode, TripLeg, Voucher } from \'../../shared/types.ts\';\\n\\ninterface LegTransitPanelProps {\\n  leg: TripLeg;\\n  modeFilter: ModeFilter;\\n  vouchers: Voucher[];\\n  isActive: boolean;\\n  onActivateLeg: (legId: string) => void;\\n  onHoverLeg: (legId: string | null) => void;\\n  onSelectOption: (legId: string, optionId: string) => void;\\n}\\n\\nfunction ModeIcon({ mode, className }: { mode: TransitMode; className?: string }) {\\n  if (mode === \'flight\') return <Plane className={className} />;\\n  if (mode === \'train\') return <TrainFront className={className} />;\\n  if (mode === \'ferry\') return <Ship className={className} />;\\n  return <Bus className={className} />;\\n}\\n\\nfunction getModeAccentClass(mode: TransitMode, isSelected: boolean): string {\\n  if (mode === \'flight\') return isSelected ? \'text-[#FF812E]\' : \'text-[#FF812E]\';\\n  if (mode === \'train\') return \'text-[#0D9488]\';\\n  if (mode === \'bus\') return \'text-[#7C3AED]\';\\n  return \'text-[#0284C7]\';\\n}\\n\\nexport function LegTransitPanel({\\n  leg,\\n  modeFilter,\\n  vouchers,\\n  isActive,\\n  onActivateLeg,\\n  onHoverLeg,\\n  onSelectOption,\\n}: LegTransitPanelProps) {\\n  const [expanded, setExpanded] = useState(leg.id === \'leg-ist-lon\' || leg.id === \'leg-lon-par\');\\n\\n  const filteredOptions =\\n    modeFilter === \'all\'\\n      ? leg.transitOptions\\n      : leg.transitOptions.filter((opt) => opt.mode === modeFilter);\\n\\n  const selectedOption =\\n    leg.transitOptions.find((o) => o.id === leg.selectedOptionId) ??\\n    leg.transitOptions[0];\\n\\n  const getVoucherCode = (voucherId?: string | null) => {\\n    if (!voucherId) return null;\\n    return vouchers.find((v) => v.id === voucherId)?.code ?? null;\\n  };\\n\\n  return (\\n    <div\\n      onMouseEnter={() => onHoverLeg(leg.id)}\\n      onMouseLeave={() => onHoverLeg(null)}\\n      className=\\\"relative pl-6 my-1.5\\\"\\n    >\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className={`absolute left-[15px] top-0 bottom-0 w-0.5 transition-colors ${\\n          isActive ? \'bg-[#FF812E]\' : \'bg-neutral-200\'\\n        }`}\\n      />\\n\\n      <div\\n        className={`rounded-2xl bg-white border transition-all ${\\n          isActive\\n            ? \'border-[#FFD6BA] shadow-md\'\\n            : \'border-neutral-200/80 shadow-sm hover:shadow-md\'\\n        }`}\\n      >\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            onActivateLeg(leg.id);\\n            setExpanded((prev) => !prev);\\n          }}\\n          className=\\\"w-full px-4 py-2.5 flex items-center justify-between gap-3 text-left cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF812E]\\\"\\n        >\\n          <div className=\\\"min-w-0 flex items-center gap-3\\\">\\n            <span\\n              className={`w-7 h-7 rounded-xl flex items-center justify-center shrink-0 ${\\n                isActive ? \'bg-[#FFF4ED]\' : \'bg-neutral-100\'\\n              }`}\\n            >\\n              {selectedOption ? (\\n                <ModeIcon\\n                  mode={selectedOption.mode}\\n                  className={`w-3.5 h-3.5 ${getModeAccentClass(selectedOption.mode, isActive)}`}\\n                />\\n              ) : (\\n                <Plane className=\\\"w-3.5 h-3.5 text-[#FF812E]\\\" />\\n              )}\\n            </span>\\n\\n            <div className=\\\"min-w-0\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-x-2 text-xs font-semibold text-[#111827]\\\">\\n                <span>\\n                  {leg.fromCode} \342\206\222 {leg.toCode}\\n                </span>\\n                <span className=\\\"font-mono text-[#4B5563] font-normal tabular-nums\\\">\\n                  {leg.distanceKm.toLocaleString()} km\\n                </span>\\n                {selectedOption && (\\n                  <>\\n                    <span className=\\\"text-neutral-300\\\" aria-hidden=\\\"true\\\">\\n                      \302\267\\n                    </span>\\n                    <span className=\\\"font-medium text-[#4B5563] truncate\\\">\\n                      {selectedOption.carrier}\\n                    </span>\\n                  </>\\n                )}\\n              </div>\\n\\n              {selectedOption && (\\n                <div className=\\\"mt-0.5 flex flex-wrap items-center gap-x-2 text-[11px] text-[#4B5563] tabular-nums\\\">\\n                  <span>\\n                    {formatDuration(selectedOption.inVehicleHours + selectedOption.layoverHours)}\\n                  </span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span>\\n                    {selectedOption.stopsCount === 0\\n                      ? \'Direct\'\\n                      : `${selectedOption.stopsCount} stop (${formatDuration(\\n                          selectedOption.layoverHours\\n                        )})`}\\n                  </span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span className=\\\"font-mono font-semibold text-[#111827]\\\">\\n                    ${selectedOption.discountedPriceUsd.toFixed(0)}\\n                  </span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span className=\\\"font-mono text-[#E56B1A] font-medium\\\">\\n                    Score ${selectedOption.smartScore.toFixed(0)}\\n                  </span>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-1.5 shrink-0 text-xs font-medium text-[#4B5563]\\\">\\n            <span className=\\\"font-mono tabular-nums\\\">{filteredOptions.length}</span>\\n            {expanded ? (\\n              <ChevronUp className=\\\"w-4 h-4 text-[#4B5563]\\\" />\\n            ) : (\\n              <ChevronDown className=\\\"w-4 h-4 text-[#4B5563]\\\" />\\n            )}\\n          </div>\\n        </button>\\n\\n        {expanded && (\\n          <div className=\\\"px-3.5 pb-3.5 pt-1 border-t border-neutral-100 space-y-2\\\">\\n            {filteredOptions.length === 0 ? (\\n              <div className=\\\"py-3 text-center text-xs text-[#4B5563]\\\">\\n                No {modeFilter} options on {leg.fromCode} \342\206\222 {leg.toCode}.\\n              </div>\\n            ) : (\\n              filteredOptions.map((option, idx) => {\\n                const isSelected = option.id === selectedOption?.id;\\n                const voucherCode = getVoucherCode(option.appliedVoucherId);\\n                const { smartScoreBreakdown: b } = option;\\n                const hasLongLayover = option.layoverHours >= 6;\\n                const hasNormalLayover = option.layoverHours >= 2 && option.layoverHours < 6;\\n\\n                return (\\n                  <button\\n                    key={option.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      onActivateLeg(leg.id);\\n                      onSelectOption(leg.id, option.id);\\n                    }}\\n                    className={`w-full text-left rounded-xl p-3 border transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF812E] ${\\n                      isSelected\\n                        ? \'bg-[#FFF4ED] border-[#FFD6BA]\'\\n                        : \'bg-white border-neutral-200/80 hover:border-neutral-300\'\\n                    }`}\\n                  >\\n                    <div className=\\\"flex items-start justify-between gap-3\\\">\\n                      <div className=\\\"min-w-0 space-y-1\\\">\\n                        <div className=\\\"flex flex-wrap items-center gap-x-2\\\">\\n                          <ModeIcon\\n                            mode={option.mode}\\n                            className={`w-3.5 h-3.5 shrink-0 ${getModeAccentClass(\\n                              option.mode,\\n                              isSelected\\n                            )}`}\\n                          />\\n                          <span className=\\\"font-semibold text-xs text-[#111827]\\\">\\n                            {option.carrier}\\n                          </span>\\n                          <span className=\\\"font-mono text-[11px] text-[#4B5563]\\\">\\n                            {option.routeCode}\\n                          </span>\\n                          {idx === 0 && (\\n                            <span className=\\\"text-[11px] font-semibold text-[#E56B1A]\\\">\\n                              \302\267 #1 Rank\\n                            </span>\\n                          )}\\n                          {option.isOvernightSleeper && (\\n                            <span className=\\\"inline-flex items-center gap-1 text-[11px] font-medium text-[#4B5563]\\\">\\n                              <Moon className=\\\"w-3 h-3 text-[#E56B1A]\\\" />\\n                              0.4x Sleeper\\n                            </span>\\n                          )}\\n                        </div>\\n\\n                        <div className=\\\"text-[11px] text-[#111827] font-mono tabular-nums\\\">\\n                          {option.departureTime} \342\206\222 {option.arrivalTime}{\' \'}\\n                          <span className=\\\"font-sans text-[#4B5563]\\\">\\n                            \302\267 {option.originStation} \342\206\222 {option.destinationStation}\\n                          </span>\\n                        </div>\\n\\n                        <div className=\\\"flex flex-wrap items-center gap-x-2 text-[11px] text-[#4B5563] tabular-nums\\\">\\n                          <span>Travel {formatDuration(option.inVehicleHours)}</span>\\n                          <span aria-hidden=\\\"true\\\">\302\267</span>\\n                          {option.layoverHours > 0 ? (\\n                            <span\\n                              className={`inline-flex items-center gap-1 ${\\n                                hasLongLayover\\n                                  ? \'text-[#DC2626] font-medium\'\\n                                  : hasNormalLayover\\n                                    ? \'text-[#D97706] font-medium\'\\n                                    : \'\'\\n                              }`}\\n                            >\\n                              {hasLongLayover && <AlertTriangle className=\\\"w-3 h-3\\\" />}\\n                              {formatDuration(option.layoverHours)} @ {option.layoverHub || \'Hub\'}{\' \'}\\n                              ({b.layoverMultiplier}x)\\n                            </span>\\n                          ) : (\\n                            <span>Direct</span>\\n                          )}\\n                          <span aria-hidden=\\\"true\\\">\302\267</span>\\n                          <span>{option.co2Kg} kg CO\342\202\202</span>\\n                        </div>\\n\\n                        {option.segments && option.segments.length > 0 && (\\n                          <div className=\\\"flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-[11px] font-mono text-[#4B5563] tabular-nums\\\">\\n                            {option.segments.map((seg, sIdx) => (\\n                              <span key={seg.id} className=\\\"inline-flex items-center gap-1\\\">\\n                                <ModeIcon\\n                                  mode={seg.mode}\\n                                  className={`w-3 h-3 ${getModeAccentClass(seg.mode, false)}`}\\n                                />\\n                                <span>\\n                                  {seg.label} ({seg.durationMinutes}m)\\n                                </span>\\n                                {sIdx < option.segments!.length - 1 && (\\n                                  <span className=\\\"text-neutral-300\\\">\342\206\222</span>\\n                                )}\\n                              </span>\\n                            ))}\\n                          </div>\\n                        )}\\n                      </div>\\n\\n                      <div className=\\\"text-right shrink-0 space-y-0.5\\\">\\n                        <div className=\\\"flex items-center justify-end gap-1.5\\\">\\n                          {b.discountAppliedUsd > 0 && (\\n                            <span className=\\\"font-mono text-[11px] text-[#4B5563] line-through tabular-nums\\\">\\n                              ${option.basePriceUsd}\\n                            </span>\\n                          )}\\n                          <span className=\\\"font-display text-sm font-bold text-[#111827] tabular-nums\\\">\\n                            ${option.discountedPriceUsd.toFixed(0)}\\n                          </span>\\n                        </div>\\n\\n                        <div className=\\\"font-mono text-[11px] font-semibold text-[#E56B1A] tabular-nums\\\">\\n                          Score ${option.smartScore.toFixed(0)}\\n                        </div>\\n\\n                        {voucherCode && b.discountAppliedUsd > 0 && (\\n                          <div className=\\\"text-[11px] font-medium text-[#16A34A] font-mono tabular-nums\\\">\\n                            -${b.discountAppliedUsd.toFixed(0)} \302\267 {voucherCode}\\n                          </div>\\n                        )}\\n\\n                        {isSelected && (\\n                          <div className=\\\"inline-flex items-center gap-1 text-[11px] font-semibold text-[#E56B1A]\\\">\\n                