        instruction: "import { buildLegsFromStops } from \'./smartScore.ts\';\nimport type { DestinationHub, TransitOption, Trip, TripStop, Voucher } from \'./types.ts\';\n\nexport const VOUCHERS_CATALOG: Voucher[] = [\n  {\n    id: \'v-astris15\',\n    code: \'ASTRIS15\',\n    title: \'15% Off Long-Haul & Regional Flights\',\n    discountType: \'percentage\',\n    discountValue: 15,\n    maxDiscountUsd: 65,\n    minSpendUsd: 120,\n    applicableModes: [\'flight\'],\n    expiresAt: \'2026-12-31\',\n    description: \'Save 15% (up to $65) on qualifying flight bookings over $120.\',\n  },\n  {\n    id: \'v-railpass20\',\n    code: \'RAIL20\',\n    title: \'$20 Off High-Speed & Sleeper Rail\',\n    discountType: \'fixed\',\n    discountValue: 20,\n    minSpendUsd: 70,\n    applicableModes: [\'train\'],\n    expiresAt: \'2026-12-31\',\n    description: \'Instant $20 credit on Eurostar, TGV, or overnight Nightjet rail legs.\',\n  },\n  {\n    id: \'v-coach10\',\n    code: \'COACH10\',\n    title: \'$10 Off Intercity Express Coaches\',\n    discountType: \'fixed\',\n    discountValue: 10,\n    minSpendUsd: 30,\n    applicableModes: [\'bus\'],\n    expiresAt: \'2026-12-31\',\n    description: \'Flat $10 off European and cross-border coach bookings over $30.\',\n  },\n  {\n    id: \'v-tkvip40\',\n    code: \'ISTHUB40\',\n    title: \'$40 Off Turkish Airlines Corridors\',\n    discountType: \'fixed\',\n    discountValue: 40,\n    minSpendUsd: 200,\n    applicableModes: [\'flight\'],\n    applicableCarriers: [\'TK\'],\n    expiresAt: \'2026-12-31\',\n    description: \'Exclusive $40 partner rebate on Turkish Airlines (TK) routes over $200.\',\n  },\n];\n\nexport const DESTINATION_HUBS: DestinationHub[] = [\n  {\n    id: \'hub-kul\',\n    city: \'Kuala Lumpur\',\n    country: \'Malaysia\',\n    iataCode: \'KUL\',\n    lat: 3.139,\n    lng: 101.6869,\n    region: \'Southeast Asia\',\n    recommendedNights: 3,\n    tagline: \'Petronas skyline, street markets & KLIA global hub\',\n  },\n  {\n    id: \'hub-ist\',\n    city: \'Istanbul\',\n    country: \'Turkey\',\n    iataCode: \'IST\',\n    lat: 41.0082,\n    lng: 28.9784,\n    region: \'Transcontinental\',\n    recommendedNights: 4,\n    tagline: \'Bosphorus crossroads linking Asia and Europe\',\n  },\n  {\n    id: \'hub-lon\',\n    city: \'London\',\n    country: \'United Kingdom\',\n    iataCode: \'LON\',\n    lat: 51.5072,\n    lng: -0.1276,\n    region: \'Western Europe\',\n    recommendedNights: 4,\n    tagline: \'St Pancras Eurostar gateway & Heathrow transatlantic hub\',\n  },\n  {\n    id: \'hub-par\',\n    city: \'Paris\',\n    country: \'France\',\n    iataCode: \'PAR\',\n    lat: 48.8566,\n    lng: 2.3522,\n    region: \'Western Europe\',\n    recommendedNights: 4,\n    tagline: \'Gare du Nord rail terminus & culinary capital\',\n  },\n  {\n    id: \'hub-dxb\',\n    city: \'Dubai\',\n    country: \'UAE\',\n    iataCode: \'DXB\',\n    lat: 25.2048,\n    lng: 55.2708,\n    region: \'Middle East\',\n    recommendedNights: 3,\n    tagline: \'Midpoint Gulf aviation hub between Asia and Europe\',\n  },\n  {\n    id: \'hub-rom\',\n    city: \'Rome\',\n    country: \'Italy\',\n    iataCode: \'ROM\',\n    lat: 41.9028,\n    lng: 12.4964,\n    region: \'Southern Europe\',\n    recommendedNights: 3,\n    tagline: \'Termini high-speed rail corridor & ancient landmarks\',\n  },\n  {\n    id: \'hub-ams\',\n    city: \'Amsterdam\',\n    country: \'Netherlands\',\n    iataCode: \'AMS\',\n    lat: 52.3676,\n    lng: 4.9041,\n    region: \'Western Europe\',\n    recommendedNights: 3,\n    tagline: \'Schiphol hub & Thalys/Eurostar canal network\',\n  },\n  {\n    id: \'hub-sin\',\n    city: \'Singapore\',\n    country: \'Singapore\',\n    iataCode: \'SIN\',\n    lat: 1.3521,\n    lng: 103.8198,\n    region: \'Southeast Asia\',\n    recommendedNights: 3,\n    tagline: \'Changi international gateway & garden metropolis\',\n  },\n];\n\nexport const INITIAL_STOPS: TripStop[] = [\n  {\n    id: \'stop-kul\',\n    order: 1,\n    city: \'Kuala Lumpur\',\n    country: \'Malaysia\',\n    iataCode: \'KUL\',\n    lat: 3.139,\n    lng: 101.6869,\n    stayNights: 3,\n    arrivalDate: \'2026-11-18\',\n    departureDate: \'2026-11-21\',\n    notes: \'Depart KL Sentral via KLIA Ekspres (28m to terminal)\',\n  },\n  {\n    id: \'stop-ist\',\n    order: 2,\n    city: \'Istanbul\',\n    country: \'Turkey\',\n    iataCode: \'IST\',\n    lat: 41.0082,\n    lng: 28.9784,\n    stayNights: 4,\n    arrivalDate: \'2026-11-22\',\n    departureDate: \'2026-11-26\',\n    notes: \'Sultanahmet & Karakoy stay; M11 Metro to IST Airport\',\n  },\n  {\n    id: \'stop-lon\',\n    order: 3,\n    city: \'London\',\n    country: \'United Kingdom\',\n    iataCode: \'LON\',\n    lat: 51.5072,\n    lng: -0.1276,\n    stayNights: 4,\n    arrivalDate: \'2026-11-26\',\n    departureDate: \'2026-11-30\',\n    notes: \'Arrive Heathrow / depart St Pancras Intl for Eurostar\',\n  },\n  {\n    id: \'stop-par\',\n    order: 4,\n    city: \'Paris\',\n    country: \'France\',\n    iataCode: \'PAR\',\n    lat: 48.8566,\n    lng: 2.3522,\n    stayNights: 4,\n    arrivalDate: \'2026-11-30\',\n    departureDate: \'2026-12-04\',\n    notes: \'Final destination \342\200\224 Le Marais & Gare du Nord arrival\',\n  },\n];\n\n// Curated corridor transit options for the 4-stop default trip (plus reverse corridors)\nfunction makeBaseOption(\n  partial: Omit<\n    TransitOption,\n    \'discountedPriceUsd\' | \'smartScore\' | \'smartScoreBreakdown\' | \'appliedVoucherId\'\n  >\n): TransitOption {\n  return {\n    ...partial,\n    discountedPriceUsd: partial.basePriceUsd,\n    smartScore: partial.basePriceUsd,\n    smartScoreBreakdown: {\n      basePriceUsd: partial.basePriceUsd,\n      discountAppliedUsd: 0,\n      discountedPriceUsd: partial.basePriceUsd,\n      hourlyRateUsd: 15,\n      inVehicleHours: partial.inVehicleHours,\n      modeMultiplier: partial.isOvernightSleeper ? 0.4 : 1.0,\n      inVehiclePenaltyUsd: 0,\n      layoverHours: partial.layoverHours,\n      layoverMultiplier: 0,\n      layoverPenaltyUsd: 0,\n      totalSmartScore: partial.basePriceUsd,\n    },\n    appliedVoucherId: null,\n  };\n}\n\nexport const CURATED_CORRIDOR_OPTIONS: Record<string, TransitOption[]> = {\n  \'KUL-IST\': [\n    makeBaseOption({\n      id: \'kul-ist-tk-direct\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Turkish Airlines\',\n      carrierCode: \'TK\',\n      routeCode: \'TK 61\',\n      originStation: \'Kuala Lumpur Intl (KUL)\',\n      destinationStation: \'Istanbul Airport (IST)\',\n      departureTime: \'23:05\',\n      arrivalTime: \'05:15 +1d\',\n      inVehicleHours: 11.2,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 465,\n      doorToDoorNotes: \'Nonstop widebody A350 \302\267 28m KLIA Ekspres + 38m M11 Metro to Gayrettepe\',\n      co2Kg: 745,\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\n    }),\n    makeBaseOption({\n      id: \'kul-ist-ey-1stop\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Etihad Airways\',\n      carrierCode: \'EY\',\n      routeCode: \'EY 411 / EY 97\',\n      originStation: \'Kuala Lumpur Intl (KUL)\',\n      destinationStation: \'Istanbul Airport (IST)\',\n      departureTime: \'19:45\',\n      arrivalTime: \'07:20 +1d\',\n      inVehicleHours: 11.6,\n      layoverHours: 2.8,\n      layoverHub: \'AUH\',\n      stopsCount: 1,\n      basePriceUsd: 392,\n      doorToDoorNotes: \'2h 48m smooth connection in Abu Dhabi Terminal A\',\n      co2Kg: 810,\n      eligibleVoucherIds: [\'v-astris15\'],\n    }),\n    makeBaseOption({\n      id: \'kul-ist-sv-saver\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Saudia Saver\',\n      carrierCode: \'SV\',\n      routeCode: \'SV 835 / SV 257\',\n      originStation: \'Kuala Lumpur Intl (KUL)\',\n      destinationStation: \'Istanbul Airport (IST)\',\n      departureTime: \'14:20\',\n      arrivalTime: \'10:35 +1d\',\n      inVehicleHours: 12.1,\n      layoverHours: 8.2,\n      layoverHub: \'JED\',\n      stopsCount: 1,\n      basePriceUsd: 329,\n      doorToDoorNotes: \'Budget fare \302\267 Long 8h 12m overnight wait at Jeddah (2.5x layover weight)\',\n      co2Kg: 842,\n      eligibleVoucherIds: [\'v-astris15\'],\n    }),\n  ],\n  \'IST-LON\': [\n    makeBaseOption({\n      id: \'ist-lon-tk-direct\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Turkish Airlines\',\n      carrierCode: \'TK\',\n      routeCode: \'TK 1985\',\n      originStation: \'Istanbul Airport (IST)\',\n      destinationStation: \'London Heathrow (LHR)\',\n      departureTime: \'08:40\',\n      arrivalTime: \'10:50\',\n      inVehicleHours: 4.15,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 218,\n      doorToDoorNotes: \'Direct Heathrow T2 \302\267 15m Heathrow Express to Paddington\',\n      co2Kg: 268,\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\n    }),\n    makeBaseOption({\n      id: \'ist-lon-pc-1stop\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Pegasus Airlines\',\n      carrierCode: \'PC\',\n      routeCode: \'PC 2662 / PC 1173\',\n      originStation: \'Sabiha Gokcen (SAW)\',\n      destinationStation: \'London Stansted (STN)\',\n      departureTime: \'06:30\',\n      arrivalTime: \'12:55\',\n      inVehicleHours: 4.9,\n      layoverHours: 3.1,\n      layoverHub: \'ADB\',\n      stopsCount: 1,\n      basePriceUsd: 152,\n      doorToDoorNotes: \'Includes 3h 06m Izmir transfer + 47m Stansted Express rail\',\n      co2Kg: 295,\n      eligibleVoucherIds: [\'v-astris15\'],\n    }),\n    makeBaseOption({\n      id: \'ist-lon-a3-long\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Aegean Saver\',\n      carrierCode: \'A3\',\n      routeCode: \'A3 991 / A3 602\',\n      originStation: \'Istanbul Airport (IST)\',\n      destinationStation: \'London Heathrow (LHR)\',\n      departureTime: \'10:15\',\n      arrivalTime: \'20:45\',\n      inVehicleHours: 4.6,\n      layoverHours: 7.4,\n      layoverHub: \'ATH\',\n      stopsCount: 1,\n      basePriceUsd: 138,\n      doorToDoorNotes: \'Lowest fare \302\267 7h 24m daytime layover in Athens (2.5x layover weight)\',\n      co2Kg: 288,\n      eligibleVoucherIds: [\'v-astris15\'],\n    }),\n    makeBaseOption({\n      id: \'ist-lon-rail-sleeper\',\n      mode: \'train\',\n      isOvernightSleeper: true,\n      carrier: \'Balkan Nightjet + Eurostar\',\n      carrierCode: \'NJ\',\n      routeCode: \'NJ 462 / ES 9132\',\n      originStation: \'Istanbul Halkali\',\n      destinationStation: \'London St Pancras Intl\',\n      departureTime: \'20:00\',\n      arrivalTime: \'19:30 +1d\',\n      inVehicleHours: 23.5,\n      layoverHours: 2.5,\n      layoverHub: \'Brussels-Midi\',\n      stopsCount: 1,\n      basePriceUsd: 245,\n      doorToDoorNotes: \'Overnight sleeper couchette (0.4x comfort weight) \302\267 89% lower CO2\',\n      co2Kg: 31,\n      eligibleVoucherIds: [\'v-railpass20\'],\n    }),\n  ],\n  \'LON-PAR\': [\n    makeBaseOption({\n      id: \'lon-par-es-direct\',\n      mode: \'train\',\n      isOvernightSleeper: false,\n      carrier: \'Eurostar\',\n      carrierCode: \'ES\',\n      routeCode: \'ES 9014\',\n      originStation: \'London St Pancras Intl\',\n      destinationStation: \'Paris Gare du Nord\',\n      departureTime: \'09:31\',\n      arrivalTime: \'12:47\',\n      inVehicleHours: 2.27,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 124,\n      doorToDoorNotes: \'City-center to city-center via Channel Tunnel \302\267 30m check-in\',\n      co2Kg: 6,\n      eligibleVoucherIds: [\'v-railpass20\'],\n    }),\n    makeBaseOption({\n      id: \'lon-par-ba-flight\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'British Airways\',\n      carrierCode: \'BA\',\n      routeCode: \'BA 308\',\n      originStation