            lines {
              text: "export function pickBestActiveVoucher("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  option: Pick<TransitOption, \'basePriceUsd\' | \'mode\' | \'carrierCode\' | \'eligibleVoucherIds\'>,"
