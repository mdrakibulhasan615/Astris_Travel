  code_action {
    action_spec {
      command {
        instruction: "Update getStopColorMap so every stop keeps a permanent color from STOP_BADGE_PALETTE without overriding the selected stop to #FF812E"
        is_edit: true
        file {
          absolute_uri: "file:///shared/dateUtils.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "/**\n * Assigns Sunset Orange (#FF812E) to the currently selected stop,\n * followed by Teal, Purple, Amber for remaining stops.\n */\nexport function getStopColorMap(\n  stops: TripStop[],\n  selectedStopId: string | null\n): Record<string, string> {\n  const map: Record<string, string> = {};\n  const secondaryPalette = STOP_BADGE_PALETTE.slice(1);\n  let secondaryIdx = 0;\n\n  for (const stop of stops) {\n    if (stop.id === selectedStopId) {\n      map[stop.id] = STOP_BADGE_PALETTE[0]; // #FF812E\n    } else {\n      map[stop.id] = secondaryPalette[secondaryIdx % secondaryPalette.length];\n      secondaryIdx += 1;\n    }\n  }\n  return map;\n}"
          replacement_content: "/**\n * Permanently assigns each stop a fixed color from STOP_BADGE_PALETTE\n * based on its sequence index (Stop 1 = #FF812E, Stop 2 = #0D9488, Stop 3 = #7C3AED, Stop 4 = #D97706)\n * so colors never swap when selecting different stops.\n */\nexport function getStopColorMap(stops: TripStop[]): Record<string, string> {\n  const map: Record<string, string> = {};\n  stops.forEach((stop, idx) => {\n    map[stop.id] = STOP_BADGE_PALETTE[idx % STOP_BADGE_PALETTE.length];\n  });\n  return map;\n}"
          start_line: 152
          end_line: 174
        }
      }
    }
