              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        carrierCode: distanceKm > 3500 ? \'TK\' : \'AS\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        routeCode: `${distanceKm > 3500 ? \'TK\' : \'AS\'} ${110 + (distanceKm % 780)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        originStation: `${fromStop.iataCode} Intl Airport`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        destinationStation: `${toStop.iataCode} Intl Airport`,"
