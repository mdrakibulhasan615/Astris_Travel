ub) => {\\n                const alreadyAdded = existingCodes.has(hub.iataCode);\\n                return (\\n                  <div\\n                    key={hub.id}\\n                    className={`flex items-center justify-between gap-3 p-3.5 rounded-xl border transition-colors ${\\n                      alreadyAdded\\n                        ? \'bg-neutral-50 border-neutral-200/70 opacity-65\'\\n                        : \'bg-white border-neutral-200/80 hover:border-[#FFD6BA] hover:bg-[#FFF4ED]/30\'\\n                    }`}\\n                  >\\n                    <div className=\\\"min-w-0\\\">\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <MapPin className=\\\"w-3.5 h-3.5 text-[#FF812E] shrink-0\\\" />\\n                        <span className=\\\"font-display font-semibold text-sm text-[#111827]\\\">\\n                          {hub.city}\\n                        </span>\\n                        <span className=\\\"text-xs text-[#4B5563]\\\">\\n                          {hub.country} \302\267 <span className=\\\"font-mono\\\">{hub.iataCode}</span>\\n                        </span>\\n                      </div>\\n                      <div className=\\\"mt-0.5 text-xs text-[#4B5563] font-mono tabular-nums\\\">\\n                        {hub.region} \302\267 {hub.recommendedNights}n default\\n                      </div>\\n                    </div>\", \"StartLine\":35, \"TargetContent\":\"        <div className=\\\"px-5 py-4 border-b border-neutral-100 flex items-center justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-lg font-bold text-[#111827]\\\">\\n              Add Destination Stop\\n            </h2>\\n            <p className=\\\"text-xs text-[#4B5563]\\\">\\n              Append a global hub to your itinerary and synthesize multi-modal corridors.\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n        