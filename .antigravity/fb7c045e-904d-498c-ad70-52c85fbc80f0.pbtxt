            lines {
              text: "export function haversineDistanceKm("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  lat1: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  lng1: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  lat2: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  lng2: number"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const R = 6371;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const toRad = (deg: number) => (deg * Math.PI) / 180;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dLat = toRad(lat2 - lat1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dLng = toRad(lng2 - lng1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const a ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.sin(dLat / 2) ** 2 +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.round(R * c);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Generates realistic multi-modal corridor options when users reorder stops or add new destinations"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
