        target_content: "\342\224\202  \342\200\242 Smart Score Engine: price + ((travelHours + layoverHours) * hourlyRate)\342\224\202\n\342\224\202  \342\200\242 Two-Stage Route Optimizer & Voucher Eligibility Matcher                \342\224\202"
        replacement_content: "\342\224\202  \342\200\242 Weighted VTTS Engine: discountedPrice + inVehicle*(rate*modeMult)       \342\224\202\n\342\224\202    + layover*(rate*layoverMult) [0.4x sleeper, 1.0x/1.5x/2.5x layover]    \342\224\202\n\342\224\202  \342\200\242 Two-Stage Route Optimizer & Voucher Eligibility Matcher                \342\224\202"
        start_line: 115
