            lines {
              text: "  const mm = String(mins).padStart(2, \'0\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return days > 0 ? `${hh}:${mm} +${days}d` : `${hh}:${mm}`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
