        target_content: "              let bgStyle: string | undefined;\n              let textColor = inMonth ? \'#111827\' : \'#9CA3AF\';\n              let pillRadius = \'rounded-full\';\n              let ringClass = \'\';\n\n              if (isDraftStart || isInDraftPreview || isDraftEnd) {\n                bgStyle = isDraftStart || isDraftEnd ? \'#FF812E\' : \'#FFF4ED\';\n                textColor = isDraftStart || isDraftEnd ? \'#FFFFFF\' : \'#C2410C\';\n                if (isDraftStart && previewEndIso) pillRadius = \'rounded-l-full\';\n                else if (isDraftEnd) pillRadius = \'rounded-r-full\';\n                else if (isInDraftPreview) pillRadius = \'rounded-none\';\n              } else if (alloc) {\n                const isActiveStopDay = alloc.stop.id === activeStop?.id;\n                if (alloc.isStart || alloc.isEndNight) {\n                  bgStyle = alloc.color;\n                  textColor = \'#FFFFFF\';\n                } else {\n                  bgStyle = isActiveStopDay ? \'#FFF4ED\' : `${alloc.color}1A`;\n                  textColor = isActiveStopDay ? \'#C2410C\' : \'#111827\';\n                }\n\n                if (alloc.isStart && alloc.isEndNight) {\n                  pillRadius = \'rounded-full\';\n                } else if (alloc.isStart) {\n                  pillRadius = \'rounded-l-full\';\n                } else if (alloc.isEndNight) {\n                  pillRadius = \'rounded-r-full\';\n                } else {\n                  pillRadius = \'rounded-none\';\n                }\n              }\n\n              if (isActiveCheckout && !alloc) {\n                ringClass = \'ring-1.5 ring-[#FF812E] text-[#E56B1A]\';\n              }\n\n              return (\n                <button\n                  key={iso}\n                  type=\"button\"\n                  onMouseEnter={() => {\n                    if (draftStartIso) setHoverIso(iso);\n                  }}\n                  onClick={() => handleDayClick(iso)}\n                  title={\n                    alloc\n                      ? `${alloc.stop.city} (${alloc.stop.arrivalDate} \342\206\222 ${alloc.stop.departureDate})`\n                      : iso\n                  }\n                  style={{\n                    backgroundColor: bgStyle,\n                    color: textColor,\n                  }}\n                  className={`h-9 flex items-center justify-center font-mono text-xs font-medium tabular-nums transition-colors cursor-pointer ${pillRadius} ${ringClass} ${\n                    !bgStyle ? \'hover:bg-slate-100\' : \'\'\n                  }`}\n                >\n                  {dayNum}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Selection status telemetry */}\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-[#4B5563] pt-1 tabular-nums\">\n            <span>\n              {draftStartIso\n                ? previewEndIso\n                  ? `${formatShortDate(draftStartIso)} \342\206\222 ${formatShortDate(\n                      previewEndIso\n                    )} (${diffDaysIso(draftStartIso, previewEndIso)}n)`\n                  : `Check-in ${formatShortDate(draftStartIso)} \302\267 Pick check-out`\n                : activeStop\n                  ? `${activeStop.city} \302\267 ${formatShortDate(activeStop.arrivalDate)} \342\206\222 ${formatShortDate(activeStop.departureDate)}`\n                  : \'\'}\n            </span>\n            {draftStartIso && (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setDraftStartIso(null);\n                  setHoverIso(null);\n                }}\n                className=\"text-[#E56B1A] font-semibold hover:underline cursor-pointer\"\n              >\n                Cancel\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Horizontal Color-Dot City Legend */}\n        <div className=\"px-5 py-3.5 bg-[#FAFAFA] border-t border-slate-100 flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex flex-wrap items-center gap-x-3.5 gap-y-1.5\">\n            {stops.map((stop) => {\n              const color = stopColorMap[stop.id] ?? \'#FF812E\';\n              const isSelected = stop.id === activeStop?.id;\n              return (\n                <button\n                  key={stop.id}\n                  type=\"button\"\n                  onClick={() => handleSelectStopTab(stop)}\n                  className={`inline-flex items-center gap-1.5 text-xs transition-colors cursor-pointer ${\n                    isSelected\n                      ? \'font-semibold text-[#111827]\'\n                      : \'font-medium text-[#4B5563] hover:text-[#111827]\'\n                  }`}\n                >\n                  <span\n                    className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                    style={{ backgroundColor: color }}\n                  />\n                  <span>{stop.city}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-3.5 py-1.5 rounded-xl bg-[#FF812E] hover:bg-[#E56B1A] text-white text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            Done\n          </button>\n        </div>"
        replacement_content: "              let bgStyle: string | undefined;\n              let textColor = inMonth ? \'#111827\' : \'#9CA3AF\';\n              let pillRadius = \'rounded-full\';\n              let boxShadowStyle: string | undefined;\n              let fontWeightClass = \'font-medium\';\n\n              if (isDraftStart || isInDraftPreview || isDraftEnd) {\n                bgStyle =\n                  isDraftStart || isDraftEnd ? activeColor : `${activeColor}1F`;\n                textColor =\n                  isDraftStart || isDraftEnd ? \'#FFFFFF\' : \'#111827\';\n                fontWeightClass =\n                  isDraftStart || isDraftEnd ? \'font-bold\' : \'font-semibold\';\n                if (isDraftStart && previewEndIso) pillRadius = \'rounded-l-full\';\n                else if (isDraftEnd) pillRadius = \'rounded-r-full\';\n                else if (isInDraftPreview) pillRadius = \'rounded-none\';\n\n                if (isDraftStart || isDraftEnd) {\n                  boxShadowStyle = `0 0 0 1.5px #FFFFFF, 0 0 0 3.5px ${activeColor}`;\n                }\n              } else if (alloc) {\n                const isActiveStopDay = alloc.stop.id === activeStop?.id;\n                if (alloc.isStart || alloc.isEndNight) {\n                  bgStyle = alloc.color;\n                  textColor = \'#FFFFFF\';\n                  fontWeightClass = isActiveStopDay ? \'font-bold\' : \'font-semibold\';\n                  if (isActiveStopDay) {\n                    boxShadowStyle = `0 0 0 1.5px #FFFFFF, 0 0 0 3.5px ${alloc.color}`;\n                  }\n                } else {\n                  bgStyle = isActiveStopDay ? `${alloc.color}24` : `${alloc.color}16`;\n                  textColor = \'#111827\';\n                  fontWeightClass = isActiveStopDay ? \'font-semibold\' : \'font-medium\';\n                }\n\n                if (alloc.isStart && alloc.isEndNight) {\n                  pillRadius = \'rounded-full\';\n                } else if (alloc.isStart) {\n                  pillRadius = \'rounded-l-full\';\n                } else if (alloc.isEndNight) {\n                  pillRadius = \'rounded-r-full\';\n                } else {\n                  pillRadius = \'rounded-none\';\n                }\n              }\n\n              if (isActiveCheckout && !alloc && !isDraftStart && !isInDraftPreview && !isDraftEnd) {\n                boxShadowStyle = `inset 0 0 0 1.5px ${activeColor}`;\n                textColor = activeColor;\n                fontWeightClass = \'font-semibold\';\n              }\n\n              return (\n                <button\n                  key={iso}\n                  type=\"button\"\n                  onMouseEnter={() => {\n                    if (draftStartIso) setHoverIso(iso);\n                  }}\n                  onClick={() => handleDayClick(iso)}\n                  title={\n                    alloc\n                      ? `${alloc.stop.city} (${alloc.stop.arrivalDate} \342\206\222 ${alloc.stop.departureDate})`\n                      : iso\n                  }\n                  style={{\n                    backgroundColor: bgStyle,\n                    color: textColor,\n                    boxShadow: boxShadowStyle,\n                  }}\n                  className={`h-9 flex items-center justify-center font-mono text-xs tabular-nums transition-all cursor-pointer ${fontWeightClass} ${pillRadius} ${\n                    !bgStyle ? \'hover:bg-slate-100\' : \'\'\n                  }`}\n                >\n                  {dayNum}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Selection status telemetry */}\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-[#4B5563] pt-1 tabular-nums\">\n            <span>\n              {draftStartIso\n                ? previewEndIso\n                  ? `${formatShortDate(draftStartIso)} \342\206\222 ${formatShortDate(\n                      previewEndIso\n                    )} (${diffDaysIso(draftStartIso, previewEndIso)}n)`\n                  : `Check-in ${formatShortDate(draftStartIso)} \302\267 Pick check-out`\n                : activeStop\n                  ? `${activeStop.city} \302\267 ${formatShortDate(activeStop.arrivalDate)} \342\206\222 ${formatShortDate(activeStop.departureDate)}`\n                  : \'\'}\n            </span>\n            {draftStartIso && (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setDraftStartIso(null);\n                  setHoverIso(null);\n                }}\n                style={{ color: activeColor }}\n                className=\"font-semibold hover:underline cursor-pointer\"\n              >\n                Cancel\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Horizontal Color-Dot City Legend */}\n        <div className=\"px-5 py-3.5 bg-[#FAFAFA] border-t border-slate-100 flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex flex-wrap items-center gap-1.5\">\n            {stops.map((stop) => {\n              const color = stopColorMap[stop.id] ?? \'#FF812E\';\n              const isSelected = stop.id === activeStop?.id;\n              return (\n                <button\n                  key={stop.id}\n                  type=\"button\"\n                  onClick={() => handleSelectStopTab(stop)}\n                  style={\n                    isSelected\n                      ? {\n                          borderColor: color,\n                          backgroundColor: `${color}12`,\n                        }\n                      : undefined\n                  }\n                  className={`inline-flex items-center gap-1.5 px-2 py-1 rounded-lg border text-xs transition-all cursor-pointer ${\n                    isSelected\n                      ? \'font-bold text-[#111827]\'\n                      : \'border-transparent font-medium text-[#4B5563] hover:text-[#111827] hover:bg-white\'\n                  }`}\n                >\n                  <span\n                    className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                    style={{ backgroundColor: color }}\n                  />\n                  <span>{stop.city}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-3.5 py-1.5 rounded-xl bg-[#FF812E] hover:bg-[#E56B1A] text-white text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            Done\n          </button>\n        </div>"
