    tool_calls {
      id: "call_17956967221027261131"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export type TransitMode = \'flight\' | \'train\' | \'bus\';\\n\\nexport type ModeFilter = \'all\' | TransitMode;\\n\\nexport type VttsTier = \'backpacker\' | \'explorer\' | \'express\' | \'custom\';\\n\\nexport interface VttsPreset {\\n  id: Exclude<VttsTier, \'custom\'>;\\n  label: string;\\n  shortLabel: string;\\n  hourlyRateUsd: number;\\n  description: string;\\n}\\n\\nexport interface SmartScoreBreakdown {\\n  basePriceUsd: number;\\n  discountAppliedUsd: number;\\n  discountedPriceUsd: number;\\n  hourlyRateUsd: number;\\n  inVehicleHours: number;\\n  modeMultiplier: number;\\n  inVehiclePenaltyUsd: number;\\n  layoverHours: number;\\n  layoverMultiplier: number;\\n  layoverPenaltyUsd: number;\\n  totalSmartScore: number;\\n}\\n\\nexport interface DestinationHub {\\n  id: string;\\n  city: string;\\n  country: string;\\n  iataCode: string;\\n  lat: number;\\n  lng: number;\\n  region: string;\\n  recommendedNights: number;\\n  tagline: string;\\n}\\n\\nexport interface TripStop {\\n  id: string;\\n  order: number;\\n  city: string;\\n  country: string;\\n  iataCode: string;\\n  lat: number;\\n  lng: number;\\n  stayNights: number;\\n  arrivalDate: string;\\n  departureDate: string;\\n  notes?: string;\\n}\\n\\nexport interface TransitOption {\\n  id: string;\\n  legId?: string;\\n  mode: TransitMode;\\n  isOvernightSleeper: boolean;\\n  carrier: string;\\n  carrierCode: string;\\n  routeCode: string;\\n  originStation: string;\\n  destinationStation: string;\\n  departureTime: string;\\n  arrivalTime: string;\\n  inVehicleHours: number;\\n  layoverHours: number;\\n  layoverHub?: string;\\n  stopsCount: number;\\n  basePriceUsd: number;\\n  discountedPriceUsd: number;\\n  smartScore: number;\\n  smartScoreBreakdown: SmartScoreBreakdown;\\n  doorToDoorNotes: string;\\n  co2Kg: number;\\n  eligibleVoucherIds: string[];\\n  appliedVoucherId?: string | null;\\n}\\n\\nexport interface TripLeg {\\n  id: string;\\n  fromStopId: string;\\n  toStopId: string;\\n  fromCity: string;\\n  fromCode: string;\\n  toCity: string;\\n  toCode: string;\\n  distanceKm: number;\\n  selectedOptionId: string;\\n  transitOptions: TransitOption[];\\n}\\n\\nexport interface Voucher {\\n  id: string;\\n  code: string;\\n  title: string;\\n  discountType: \'percentage\' | \'fixed\';\\n  discountValue: number;\\n  maxDiscountUsd?: number;\\n  minSpendUsd: number;\\n  applicableModes: TransitMode[];\\n  applicableCarriers?: string[];\\n  expiresAt: string;\\n  description: string;\\n}\\n\\nexport interface Trip {\\n  id: string;\\n  title: string;\\n  travelers: number;\\n  currency: \'USD\';\\n  vttsTier: VttsTier;\\n  hourlyTimeValue: number;\\n  stops: TripStop[];\\n  legs: TripLeg[];\\n  appliedVoucherCodes: string[];\\n}\\n\\nexport interface OptimizationCandidate {\\n  stopIds: string[];\\n  routeLabels: string[];\\n  totalDistanceKm: number;\\n  estimatedTotalCostUsd: number;\\n  estimatedTotalHours: number;\\n  totalSmartScore: number;\\n  stage1Rank: number;\\n}\\n\\nexport interface RouteOptimizationResult {\\n  originalDistanceKm: number;\\n  optimizedDistanceKm: number;\\n  distanceSavedKm: number;\\n  originalCostUsd: number;\\n  optimizedCostUsd: number;\\n  originalSmartScore: number;\\n  optimizedSmartScore: number;\\n  optimizedStops: TripStop[];\\n  optimizedLegs: TripLeg[];\\n  candidatesEvaluated: number;\\n  topCandidates: OptimizationCandidate[];\\n  alreadyOptimal: boolean;\\n  summaryMessage: string;\\n}\\n\\nexport interface VoucherValidationResult {\\n  valid: boolean;\\n  voucher?: Voucher;\\n  reason?: string;\\n  eligibleLegIds: string[];\\n  estimatedSavingsUsd: number;\\n}\\n\", \"Description\":\"Define shared TypeScript models for Trip, TripStop, TripLeg, TransitOption, SmartScoreBreakdown, Voucher, and RouteOptimizationResult.\", \"Overwrite\":true, \"TargetFile\":\"/shared/types.ts\", \"toolAction\":\"Creating shared TypeScript contracts\", \"toolSummary\":\"Create shared TypeScript models\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17956967221027260180"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type {\\n  SmartScoreBreakdown,\\n  TransitMode,\\n  TransitOption,\\n  TripLeg,\\n  TripStop,\\n  Voucher,\\n  VttsPreset,\\n} from \'./types.ts\';\\n\\nexport const VTTS_PRESETS: VttsPreset[] = [\\n  {\\n    id: \'backpacker\',\\n    label: \'Budget Backpacker\',\\n    shortLabel: \'Backpacker\',\\n    hourlyRateUsd: 5,\\n    description: \'Maximizes cash savings; tolerant of longer transit and transfers.\',\\n  },\\n  {\\n    id: \'explorer\',\\n    label: \'Balanced Explorer\',\\n    shortLabel: \'Balanced\',\\n    hourlyRateUsd: 15,\\n    description: \'Balanced trade-off between ticket fare and comfortable travel hours.\',\\n  },\\n  {\\n    id: \'express\',\\n    label: \'Time-Rich / Express\',\\n    shortLabel: \'Express\',\\n    hourlyRateUsd: 35,\\n    description: \'Prioritizes direct corridors and heavily penalizes long layovers.\',\\n  },\\n];\\n\\nexport function getLayoverMultiplier(layoverHours: number): number {\\n  if (layoverHours <= 0) return 0;\\n  if (layoverHours < 2) return 1.0;\\n  if (layoverHours < 6) return 1.5;\\n  return 2.5;\\n}\\n\\nexport function getModeMultiplier(isOvernightSleeper: boolean): number {\\n  return isOvernightSleeper ? 0.4 : 1.0;\\n}\\n\\nexport function round2(value: number): number {\\n  return Math.round(value * 100) / 100;\\n}\\n\\nexport function calculateVoucherDiscount(\\n  option: Pick<TransitOption, \'basePriceUsd\' | \'mode\' | \'carrierCode\' | \'eligibleVoucherIds\'>,\\n  voucher: Voucher | null | undefined\\n): number {\\n  if (!voucher) return 0;\\n  if (!voucher.applicableModes.includes(option.mode)) return 0;\\n  if (option.basePriceUsd < voucher.minSpendUsd) return 0;\\n  if (\\n    voucher.applicableCarriers &&\\n    voucher.applicableCarriers.length > 0 &&\\n    !voucher.applicableCarriers.includes(option.carrierCode)\\n  ) {\\n    return 0;\\n  }\\n\\n  let discount =\\n    voucher.discountType === \'percentage\'\\n      ? (option.basePriceUsd * voucher.discountValue) / 100\\n      : voucher.discountValue;\\n\\n  if (voucher.maxDiscountUsd !== undefined) {\\n    discount = Math.min(discount, voucher.maxDiscountUsd);\\n  }\\n\\n  return round2(Math.min(discount, option.basePriceUsd));\\n}\\n\\nexport function computeSmartScore(\\n  option: Pick<\\n    TransitOption,\\n    \'basePriceUsd\' | \'inVehicleHours\' | \'layoverHours\' | \'isOvernightSleeper\' | \'mode\' | \'carrierCode\' | \'eligibleVoucherIds\'\\n  >,\\n  hourlyRateUsd: number,\\n  bestVoucher?: Voucher | null\\n): SmartScoreBreakdown {\\n  const discountAppliedUsd = calculateVoucherDiscount(option, bestVoucher);\\n  const discountedPriceUsd = round2(Math.max(0, option.basePriceUsd - discountAppliedUsd));\\n\\n  const modeMultiplier = getModeMultiplier(option.isOvernightSleeper);\\n  const layoverMultiplier = getLayoverMultiplier(option.layoverHours);\\n\\n  const inVehiclePenaltyUsd = round2(option.inVehicleHours * hourlyRateUsd * modeMultiplier);\\n  const layoverPenaltyUsd = round2(option.layoverHours * hourlyRateUsd * layoverMultiplier);\\n  const totalSmartScore = round2(discountedPriceUsd + inVehiclePenaltyUsd + layoverPenaltyUsd);\\n\\n  return {\\n    basePriceUsd: option.basePriceUsd,\\n    discountAppliedUsd,\\n    discountedPriceUsd,\\n    hourlyRateUsd,\\n    inVehicleHours: option.inVehicleHours,\\n    modeMultiplier,\\n    inVehiclePenaltyUsd,\\n    layoverHours: option.layoverHours,\\n    layoverMultiplier,\\n    layoverPenaltyUsd,\\n    totalSmartScore,\\n  };\\n}\\n\\nexport function pickBestActiveVoucher(\\n  option: Pick<TransitOption, \'basePriceUsd\' | \'mode\' | \'carrierCode\' | \'eligibleVoucherIds\'>,\\n  activeVouchers: Voucher[]\\n): { voucher: Voucher | null; discountUsd: number } {\\n  let bestVoucher: Voucher | null = null;\\n  let bestDiscount = 0;\\n\\n  for (const voucher of activeVouchers) {\\n    const discount = calculateVoucherDiscount(option, voucher);\\n    if (discount > bestDiscount) {\\n      bestDiscount = discount;\\n      bestVoucher = voucher;\\n    }\\n  }\\n\\n  return { voucher: bestVoucher, discountUsd: bestDiscount };\\n}\\n\\nexport function recalculateOptionsWithVttsAndVouchers(\\n  options: TransitOption[],\\n  hourlyRateUsd: number,\\n  activeVouchers: Voucher[]\\n): TransitOption[] {\\n  return options\\n    .map((option) => {\\n      const { voucher } = pickBestActiveVoucher(option, activeVouchers);\\n      const breakdown = computeSmartScore(option, hourlyRateUsd, voucher);\\n      return {\\n        ...option,\\n        discountedPriceUsd: breakdown.discountedPriceUsd,\\n        smartScore: breakdown.totalSmartScore,\\n        smartScoreBreakdown: breakdown,\\n        appliedVoucherId: voucher ? voucher.id : null,\\n      };\\n    })\\n    .sort((a, b) => a.smartScore - b.smartScore);\\n}\\n\\nexport function haversineDistanceKm(\\n  lat1: number,\\n  lng1: number,\\n  lat2: number,\\n  lng2: number\\n): number {\\n  const R = 6371;\\n  const toRad = (deg: number) => (deg * Math.PI) / 180;\\n  const dLat = toRad(lat2 - lat1);\\n  const dLng = toRad(lng2 - lng1);\\n  const a =\\n    Math.sin(dLat / 2) ** 2 +\\n    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;\\n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\\n  return Math.round(R * c);\\n}\\n\\n/**\\n * Generates realistic multi-modal corridor options when users reorder stops or add new destinations\\n * that do not have a pre-authored static corridor entry.\\n */\\nexport function synthesizeCorridorOptions(\\n  fromStop: TripStop,\\n  toStop: TripStop,\\n  legId: string,\\n  allVouchers: Voucher[],\\n  hourlyRateUsd: number,\\n  activeVouchers: Voucher[]\\n): TransitOption[] {\\n  const distanceKm = Math.max(120, haversineDistanceKm(fromStop.lat, fromStop.lng, toStop.lat, toStop.lng));\\n  const options: TransitOption[] = [];\\n\\n  // 1. Direct or fast flight\\n  const directFlightHours = round2(1.1 + distanceKm / 810);\\n  const directFlightPrice = Math.round(78 + distanceKm * 0.056);\\n  options.push(\\n    buildRawOption(\\n      {\\n        id: `${legId}-flt-direct`,\\n        legId,\\n        mode: \'flight\',\\n        isOvernightSleeper: false,\\n        carrier: distanceKm > 3500 ? \'Turkish Airlines\' : \'Astris Skyways\',\\n        carrierCode: distanceKm > 3500 ? \'TK\' : \'AS\',\\n        routeCode: `${distanceKm > 3500 ? \'TK\' : \'AS\'} ${110 + (distanceKm % 780)}`,\\n        originStation: `${fromStop.iataCode} Intl Airport`,\\n        destinationStation: `${toStop.iataCode} Intl Airport`,\\n        departureTime: \'09:40\',\\n        arrivalTime: formatArrivalFromHours(9.67 + directFlightHours),\\n        inVehicleHours: directFlightHours,\\n        layoverHours: 0,\\n        stopsCount: 0,\\n        basePriceUsd: directFlightPrice,\\n        doorToDoorNotes: `Express airport rail transfer included at ${fromStop.city} & ${toStop.city}.`,\\n        co2Kg: Math.round(distanceKm * 0.115),\\n      },\\n      allVouchers\\n    )\\n  );\\n\\n  // 2. Value 1-stop connecting flight (longer corridors)\\n  if (distanceKm > 950) {\\n    const layoverHrs = distanceKm > 4500 ? 6.5 : 3.2;\\n    const oneStopHours = round2(directFlightHours + 1.2);\\n    const oneStopPrice = Math.round(directFlightPrice * 0.76);\\n    options.push(\\n      buildRawOption(\\n        {\\n          id: `${legId}-flt-connect`,\\n          legId,\\n          mode: \'flight\',\\n          isOvernightSleeper: false,\\n          carrier: \'Pegasus Connect\',\\n          carrierCode: \'PC\',\\n          routeCode: `PC ${302 + (distanceKm % 500)}`,\\n          originStation: `${fromStop.iataCode} Terminal 1`,\\n          destinationStation: `${toStop.iataCode} Terminal 2`,\\n          departureTime: \'13:15\',\\n          arrivalTime: formatArrivalFromHours(13.25 + oneStopHours + layoverHrs),\\n          inVehicleHours: oneStopHours,\\n          layoverHours: layoverHrs,\\n          layoverHub: distanceKm > 4500 ? \'DOH\' : \'SAW\',\\n          stopsCount: 1,\\n          basePriceUsd: oneStopPrice,\\n          doorToDoorNotes: `1-stop saver fare with ${layoverHrs}h terminal transfer.`,\\n          co2Kg: Math.round(distanceKm * 0.132),\\n        },\\n        allVouchers\\n      )\\n    );\\n  }\\n\\n  // 3. Rail option (high-speed for <=1400km, sleeper rail for 700-2400km)\\n  if (distanceKm <= 2600) {\\n    const isSleeper = distanceKm > 750;\\n    const trainHours = round2(isSleeper ? 2.0 + distanceKm / 125 : 0.8 + distanceKm / 215);\\n    const trainPrice = Math.round(isSleeper ? 68 + distanceKm * 0.065 : 54 + distanceKm * 0.11);\\n    options.push(\\n      buildRawOption(\\n        {\\n          id: `${legId}-trn-rail`,\\n          legId,\\n          mode: \'train\',\\n          isOvernightSleeper: isSleeper,\\n          carrier: isSleeper ? \'Nightjet Sleeper Rail\' : \'EuroExpress Rail\',\\n          carrierCode: isSleeper ? \'NJ\' : \'EE\',\\n          routeCode: `${isSleeper ? \'NJ\' : \'EE\'} ${400 + (distanceKm % 300)}`,\\n          originStation: `${fromStop.city} Central Station`,\\n          destinationStation: `${toStop.city} Central Station`,\\n          departureTime: isSleeper ? \'21:15\' : \'10:30\',\\n          arrivalTime: formatArrivalFromHours((isSleeper ? 21.25 : 10.5) + trainHours),\\n          inVehicleHours: trainHours,\\n          layoverHours: distanceKm > 1200 ? 1.4 : 0,\\n          stopsCount: distanceKm > 1200 ? 1 : 0,\\n          basePriceUsd: trainPrice,\\n          doorToDoorNotes: isSleeper\\n            ? \'City-center overnight couchette; saves a hotel night and applies 0.4x sleeper comfort weight.\'\\n            : \'City-center to city-center high-speed rail; zero airport check-in buffer.\',\\n          co2Kg: Math.round(distanceKm * 0.024),\\n        },\\n        allVouchers\\n      )\\n    );\\n  }\\n\\n  // 4. Intercity bus option (for <=2200km)\\n  if (distanceKm <= 2200) {\\n    const isSleeperBus = distanceKm > 550;\\n    const busHours = round2(1.0 + distanceKm / 78);\\n    const busPrice = Math.round(24 + distanceKm * 0.036);\\n    options.push(\\n      buildRawOption(\\n        {\\n          id: `${legId}-bus-coach`,\\n          legId,\\n          mode: \'bus\',\\n          isOvernightSleeper: isSleeperBus,\\n          carrier: \'FlixCoach Express\',\\n          carrierCode: \'FX\',\\n          routeCode: `FX ${800 + (distanceKm % 190)}`,\\n          originStation: `${fromStop.city} Coach Hub`,\\n          destinationStation: `${toStop.city} South Terminal`,\\n          departureTime: isSleeperBus ? \'22:00\' : \'08:15\',\\n          arrivalTime: formatArrivalFromHours((isSleeperBus ? 22 : 8.25) + busHours),\\n          inVehicleHours: busHours,\\n          layoverHours: distanceKm > 1100 ? 2.2 : 0,\\n          stopsCount: distanceKm > 1100 ? 1 : 0,\\n          basePriceUsd: busPrice,\\n          doorToDoorNotes: \'Direct coach terminal departure with Wi-Fi and 2 checked bags included.\',\\n          co2Kg: Math.round(distanceKm * 0.038),\\n        },\\n        allVouchers\\n      )\\n    );\\n  }\\n\\n  return recalculateOptionsWithVttsAndVouchers(options, hourlyRateUsd, activeVouchers);\\n}\\n\\nfunction buildRawOption(\\n  partial: Omit<\\n    TransitOption,\\n    \'discountedPriceUsd\' | \'smartScore\' | \'smartScoreBreakdown\' | \'eligibleVoucherIds\'\\n  >,\\n  allVouchers: Voucher[]\\n): TransitOption {\\n  const eligibleVoucherIds = allVouchers\\n    .filter((v) => v.applicableModes.includes(partial.mode) && partial.basePriceUsd >= v.minSpendUsd)\\n    .map((v) => v.id);\\n\\n  const placeholderBreakdown = computeSmartScore(\\n    {\\n      ...partial,\\n      eligibleVoucherIds,\\n    },\\n    15,\\n    null\\n  );\\n\\n  return {\\n    ...partial,\\n    discountedPriceUsd: partial.basePriceUsd,\\n    smartScore: placeholderBreakdown.totalSmartScore,\\n    smartScoreBreakdown: placeholderBreakdown,\\n    eligibleVoucherIds,\\n    appliedVoucherId: null,\\n  };\\n}\\n\\nfunction formatArrivalFromHours(totalHours: number): string {\\n  const days = Math.floor(totalHours / 24);\\n  const rem = totalHours % 24;\\n  const hrs = Math.floor(rem);\\n  const mins = Math.round((rem - hrs) * 60) % 60;\\n  const hh = String(hrs).padStart(2, \'0\');\\n  const mm = String(mins).padStart(2, \'0\');\\n  return days > 0 ? `${hh}:${mm} +${days}d` : `${hh}:${mm}`;\\n}\\n\\nexport function formatDuration(hours: number): string {\\n  const wholeHours = Math.floor(hours);\\n  const mins = Math.round((hours - wholeHours) * 60);\\n  if (mins === 0) return `${wholeHours}h`;\\n  return `${wholeHours}h ${mins}m`;\\n}\\n\\nexport function buildLegsFromStops(\\n  stops: TripStop[],\\n  curatedCorridors: Record<string, TransitOption[]>,\\n  allVouchers: Voucher[],\\n  hourlyRateUsd: number,\\n  activeVouchers: Voucher[],\\n  previousSelectedMap?: Record<string, string>\\n): TripLeg[] {\\n  const legs: TripLeg[] = [];\\n  for (let i = 0; i < stops.length - 1; i++) {\\n    const fromStop = stops[i];\\n    const toStop = stops[i + 1];\\n    const corridorKey = `${fromStop.iataCode}-${toStop.iataCode}`;\\n    const legId = `leg-${fromStop.iataCode.toLowerCase()}-${toStop.iataCode.toLowerCase()}`;\\n    const distanceKm = haversineDistanceKm(fromStop.lat, fromStop.lng, toStop.lat, toStop.lng);\\n\\n    const baseOptions = curatedCorridors[corridorKey]\\n      ? curatedCorridors[corridorKey].map((opt) => ({ ...opt, legId }))\\n      : synthesizeCorridorOptions(fromStop, toStop, legId, allVouchers, hourlyRateUsd, activeVouchers);\\n\\n    const rankedOptions = recalculateOptionsWithVttsAndVouchers(\\n      baseOptions,\\n      hourlyRateUsd,\\n      activeVouchers\\n    );\\n\\n    const prevSelected = previousSelectedMap?.[legId];\\n    const validPrev = rankedOptions.some((o) => o.id === prevSelected);\\n\\n    legs.push({\\n      id: legId,\\n      fromStopId: fromStop.id,\\n      toStopId: toStop.id,\\n      fromCity: fromStop.city,\\n      fromCode: fromStop.iataCode,\\n      toCity: toStop.city,\\n      toCode: toStop.iataCode,\\n      distanceKm,\\n      selectedOptionId: validPrev ? prevSelected! : rankedOptions[0]?.id ?? \'\',\\n      transitOptions: rankedOptions,\\n    });\\n  }\\n  return legs;\\n}\\n\\nexport function calculateBestModeFilterMatch(\\n  options: TransitOption[],\\n  mode: \'all\' | TransitMode\\n): TransitOption[] {\\n  if (mode === \'all\') return options;\\n  return options.filter((o) => o.mode === mode);\\n}\\n\", \"Description\":\"Create shared Smart Score VTTS engine, voucher calculator, Haversine distance utility, and dynamic corridor synthesizer.\", \"Overwrite\":true, \"TargetFile\":\"/shared/smartScore.ts\", \"toolAction\":\"Creating Smart Score VTTS engine\", \"toolSummary\":\"Create Smart Score engine\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17956967221027259229"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { buildLegsFromStops } from \'./smartScore.ts\';\\nimport type { DestinationHub, TransitOption, Trip, TripStop, Voucher } from \'./types.ts\';\\n\\nexport const VOUCHERS_CATALOG: Voucher[] = [\\n  {\\n    id: \'v-astris15\',\\n    code: \'ASTRIS15\',\\n    title: \'15% Off Long-Haul & Regional Flights\',\\n    discountType: \'percentage\',\\n    discountValue: 15,\\n    maxDiscountUsd: 65,\\n    minSpendUsd: 120,\\n    applicableModes: [\'flight\'],\\n    expiresAt: \'2026-12-31\',\\n    description: \'Save 15% (up to $65) on qualifying flight bookings over $120.\',\\n  },\\n  {\\n    id: \'v-railpass20\',\\n    code: \'RAIL20\',\\n    title: \'$20 Off High-Speed & Sleeper Rail\',\\n    discountType: \'fixed\',\\n    discountValue: 20,\\n    minSpendUsd: 70,\\n    applicableModes: [\'train\'],\\n    expiresAt: \'2026-12-31\',\\n    description: \'Instant $20 credit on Eurostar, TGV, or overnight Nightjet rail legs.\',\\n  },\\n  {\\n    id: \'v-coach10\',\\n    code: \'COACH10\',\\n    title: \'$10 Off Intercity Express Coaches\',\\n    discountType: \'fixed\',\\n    discountValue: 10,\\n    minSpendUsd: 30,\\n    applicableModes: [\'bus\'],\\n    expiresAt: \'2026-12-31\',\\n    description: \'Flat $10 off European and cross-border coach bookings over $30.\',\\n  },\\n  {\\n    id: \'v-tkvip40\',\\n    code: \'ISTHUB40\',\\n    title: \'$40 Off Turkish Airlines Corridors\',\\n    discountType: \'fixed\',\\n    discountValue: 40,\\n    minSpendUsd: 200,\\n    applicableModes: [\'flight\'],\\n    applicableCarriers: [\'TK\'],\\n    expiresAt: \'2026-12-31\',\\n    description: \'Exclusive $40 partner rebate on Turkish Airlines (TK) routes over $200.\',\\n  },\\n];\\n\\nexport const DESTINATION_HUBS: DestinationHub[] = [\\n  {\\n    id: \'hub-kul\',\\n    city: \'Kuala Lumpur\',\\n    country: \'Malaysia\',\\n    iataCode: \'KUL\',\\n    lat: 3.139,\\n    lng: 101.6869,\\n    region: \'Southeast Asia\',\\n    recommendedNights: 3,\\n    tagline: \'Petronas skyline, street markets & KLIA global hub\',\\n  },\\n  {\\n    id: \'hub-ist\',\\n    city: \'Istanbul\',\\n    country: \'Turkey\',\\n    iataCode: \'IST\',\\n    lat: 41.0082,\\n    lng: 28.9784,\\n    region: \'Transcontinental\',\\n    recommendedNights: 4,\\n    tagline: \'Bosphorus crossroads linking Asia and Europe\',\\n  },\\n  {\\n    id: \'hub-lon\',\\n    city: \'London\',\\n    country: \'United Kingdom\',\\n    iataCode: \'LON\',\\n    lat: 51.5072,\\n    lng: -0.1276,\\n    region: \'Western Europe\',\\n    recommendedNights: 4,\\n    tagline: \'St Pancras Eurostar gateway & Heathrow transatlantic hub\',\\n  },\\n  {\\n    id: \'hub-par\',\\n    city: \'Paris\',\\n    country: \'France\',\\n    iataCode: \'PAR\',\\n    lat: 48.8566,\\n    lng: 2.3522,\\n    region: \'Western Europe\',\\n    recommendedNights: 4,\\n    tagline: \'Gare du Nord rail terminus & culinary capital\',\\n  },\\n  {\\n    id: \'hub-dxb\',\\n    city: \'Dubai\',\\n    country: \'UAE\',\\n    iataCode: \'DXB\',\\n    lat: 25.2048,\\n    lng: 55.2708,\\n    region: \'Middle East\',\\n    recommendedNights: 3,\\n    tagline: \'Midpoint Gulf aviation hub between Asia and Europe\',\\n  },\\n  {\\n    id: \'hub-rom\',\\n    city: \'Rome\',\\n    country: \'Italy\',\\n    iataCode: \'ROM\',\\n    lat: 41.9028,\\n    lng: 12.4964,\\n    region: \'Southern Europe\',\\n    recommendedNights: 3,\\n    tagline: \'Termini high-speed rail corridor & ancient landmarks\',\\n  },\\n  {\\n    id: \'hub-ams\',\\n    city: \'Amsterdam\',\\n    country: \'Netherlands\',\\n    iataCode: \'AMS\',\\n    lat: 52.3676,\\n    lng: 4.9041,\\n    region: \'Western Europe\',\\n    recommendedNights: 3,\\n    tagline: \'Schiphol hub & Thalys/Eurostar canal network\',\\n  },\\n  {\\n    id: \'hub-sin\',\\n    city: \'Singapore\',\\n    country: \'Singapore\',\\n    iataCode: \'SIN\',\\n    lat: 1.3521,\\n    lng: 103.8198,\\n    region: \'Southeast Asia\',\\n    recommendedNights: 3,\\n    tagline: \'Changi international gateway & garden metropolis\',\\n  },\\n];\\n\\nexport const INITIAL_STOPS: TripStop[] = [\\n  {\\n    id: \'stop-kul\',\\n    order: 1,\\n    city: \'Kuala Lumpur\',\\n    country: \'Malaysia\',\\n    iataCode: \'KUL\',\\n    lat: 3.139,\\n    lng: 101.6869,\\n    stayNights: 3,\\n    arrivalDate: \'2026-11-18\',\\n    departureDate: \'2026-11-21\',\\n    notes: \'Depart KL Sentral via KLIA Ekspres (28m to terminal)\',\\n  },\\n  {\\n    id: \'stop-ist\',\\n    order: 2,\\n    city: \'Istanbul\',\\n    country: \'Turkey\',\\n    iataCode: \'IST\',\\n    lat: 41.0082,\\n    lng: 28.9784,\\n    stayNights: 4,\\n    arrivalDate: \'2026-11-22\',\\n    departureDate: \'2026-11-26\',\\n    notes: \'Sultanahmet & Karakoy stay; M11 Metro to IST Airport\',\\n  },\\n  {\\n    id: \'stop-lon\',\\n    order: 3,\\n    city: \'London\',\\n    country: \'United Kingdom\',\\n    iataCode: \'LON\',\\n    lat: 51.5072,\\n    lng: -0.1276,\\n    stayNights: 4,\\n    arrivalDate: \'2026-11-26\',\\n    departureDate: \'2026-11-30\',\\n    notes: \'Arrive Heathrow / depart St Pancras Intl for Eurostar\',\\n  },\\n  {\\n    id: \'stop-par\',\\n    order: 4,\\n    city: \'Paris\',\\n    country: \'France\',\\n    iataCode: \'PAR\',\\n    lat: 48.8566,\\n    lng: 2.3522,\\n    stayNights: 4,\\n    arrivalDate: \'2026-11-30\',\\n    departureDate: \'2026-12-04\',\\n    notes: \'Final destination \342\200\224 Le Marais & Gare du Nord arrival\',\\n  },\\n];\\n\\n// Curated corridor transit options for the 4-stop default trip (plus reverse corridors)\\nfunction makeBaseOption(\\n  partial: Omit<\\n    TransitOption,\\n    \'discountedPriceUsd\' | \'smartScore\' | \'smartScoreBreakdown\' | \'appliedVoucherId\'\\n  >\\n): TransitOption {\\n  return {\\n    ...partial,\\n    discountedPriceUsd: partial.basePriceUsd,\\n    smartScore: partial.basePriceUsd,\\n    smartScoreBreakdown: {\\n      basePriceUsd: partial.basePriceUsd,\\n      discountAppliedUsd: 0,\\n      discountedPriceUsd: partial.basePriceUsd,\\n      hourlyRateUsd: 15,\\n      inVehicleHours: partial.inVehicleHours,\\n      modeMultiplier: partial.isOvernightSleeper ? 0.4 : 1.0,\\n      inVehiclePenaltyUsd: 0,\\n      layoverHours: partial.layoverHours,\\n      layoverMultiplier: 0,\\n      layoverPenaltyUsd: 0,\\n      totalSmartScore: partial.basePriceUsd,\\n    },\\n    appliedVoucherId: null,\\n  };\\n}\\n\\nexport const CURATED_CORRIDOR_OPTIONS: Record<string, TransitOption[]> = {\\n  \'KUL-IST\': [\\n    makeBaseOption({\\n      id: \'kul-ist-tk-direct\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Turkish Airlines\',\\n      carrierCode: \'TK\',\\n      routeCode: \'TK 61\',\\n      originStation: \'Kuala Lumpur Intl (KUL)\',\\n      destinationStation: \'Istanbul Airport (IST)\',\\n      departureTime: \'23:05\',\\n      arrivalTime: \'05:15 +1d\',\\n      inVehicleHours: 11.2,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 465,\\n      doorToDoorNotes: \'Nonstop widebody A350 \302\267 28m KLIA Ekspres + 38m M11 Metro to Gayrettepe\',\\n      co2Kg: 745,\\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\\n    }),\\n    makeBaseOption({\\n      id: \'kul-ist-ey-1stop\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Etihad Airways\',\\n      carrierCode: \'EY\',\\n      routeCode: \'EY 411 / EY 97\',\\n      originStation: \'Kuala Lumpur Intl (KUL)\',\\n      destinationStation: \'Istanbul Airport (IST)\',\\n      departureTime: \'19:45\',\\n      arrivalTime: \'07:20 +1d\',\\n      inVehicleHours: 11.6,\\n      layoverHours: 2.8,\\n      layoverHub: \'AUH\',\\n      stopsCount: 1,\\n      basePriceUsd: 392,\\n      doorToDoorNotes: \'2h 48m smooth connection in Abu Dhabi Terminal A\',\\n      co2Kg: 810,\\n      eligibleVoucherIds: [\'v-astris15\'],\\n    }),\\n    makeBaseOption({\\n      id: \'kul-ist-sv-saver\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Saudia Saver\',\\n      carrierCode: \'SV\',\\n      routeCode: \'SV 835 / SV 257\',\\n      originStation: \'Kuala Lumpur Intl (KUL)\',\\n      destinationStation: \'Istanbul Airport (IST)\',\\n      departureTime: \'14:20\',\\n      arrivalTime: \'10:35 +1d\',\\n      inVehicleHours: 12.1,\\n      layoverHours: 8.2,\\n      layoverHub: \'JED\',\\n      stopsCount: 1,\\n      basePriceUsd: 329,\\n      doorToDoorNotes: \'Budget fare \302\267 Long 8h 12m overnight wait at Jeddah (2.5x layover weight)\',\\n      co2Kg: 842,\\n      eligibleVoucherIds: [\'v-astris15\'],\\n    }),\\n  ],\\n  \'IST-LON\': [\\n    makeBaseOption({\\n      id: \'ist-lon-tk-direct\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Turkish Airlines\',\\n      carrierCode: \'TK\',\\n      routeCode: \'TK 1985\',\\n      originStation: \'Istanbul Airport (IST)\',\\n      destinationStation: \'London Heathrow (LHR)\',\\n      departureTime: \'08:40\',\\n      arrivalTime: \'10:50\',\\n      inVehicleHours: 4.15,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 218,\\n      doorToDoorNotes: \'Direct Heathrow T2 \302\267 15m Heathrow Express to Paddington\',\\n      co2Kg: 268,\\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\\n    }),\\n    makeBaseOption({\\n      id: \'ist-lon-pc-1stop\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Pegasus Airlines\',\\n      carrierCode: \'PC\',\\n      routeCode: \'PC 2662 / PC 1173\',\\n      originStation: \'Sabiha Gokcen (SAW)\',\\n      destinationStation: \'London Stansted (STN)\',\\n      departureTime: \'06:30\',\\n      arrivalTime: \'12:55\',\\n      inVehicleHours: 4.9,\\n      layoverHours: 3.1,\\n      layoverHub: \'ADB\',\\n      stopsCount: 1,\\n      basePriceUsd: 152,\\n      doorToDoorNotes: \'Includes 3h 06m Izmir transfer + 47m Stansted Express rail\',\\n      co2Kg: 295,\\n      eligibleVoucherIds: [\'v-astris15\'],\\n    }),\\n    makeBaseOption({\\n      id: \'ist-lon-a3-long\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Aegean Saver\',\\n      carrierCode: \'A3\',\\n      routeCode: \'A3 991 / A3 602\',\\n      originStation: \'Istanbul Airport (IST)\',\\n      destinationStation: \'London Heathrow (LHR)\',\\n      departureTime: \'10:15\',\\n      arrivalTime: \'20:45\',\\n      inVehicleHours: 4.6,\\n      layoverHours: 7.4,\\n      layoverHub: \'ATH\',\\n      stopsCount: 1,\\n      basePriceUsd: 138,\\n      doorToDoorNotes: \'Lowest fare \302\267 7h 24m daytime layover in Athens (2.5x layover weight)\',\\n      co2Kg: 288,\\n      eligibleVoucherIds: [\'v-astris15\'],\\n    }),\\n    makeBaseOption({\\n      id: \'ist-lon-rail-sleeper\',\\n      mode: \'train\',\\n      isOvernightSleeper: true,\\n      carrier: \'Balkan Nightjet + Eurostar\',\\n      carrierCode: \'NJ\',\\n      routeCode: \'NJ 462 / ES 9132\',\\n      originStation: \'Istanbul Halkali\',\\n      destinationStation: \'London St Pancras Intl\',\\n      departureTime: \'20:00\',\\n      arrivalTime: \'19:30 +1d\',\\n      inVehicleHours: 23.5,\\n      layoverHours: 2.5,\\n      layoverHub: \'Brussels-Midi\',\\n      stopsCount: 1,\\n      basePriceUsd: 245,\\n      doorToDoorNotes: \'Overnight sleeper couchette (0.4x comfort weight) \302\267 89% lower CO2\',\\n      co2Kg: 31,\\n      eligibleVoucherIds: [\'v-railpass20\'],\\n    }),\\n  ],\\n  \'LON-PAR\': [\\n    makeBaseOption({\\n      id: \'lon-par-es-direct\',\\n      mode: \'train\',\\n      isOvernightSleeper: false,\\n      carrier: \'Eurostar\',\\n      carrierCode: \'ES\',\\n      routeCode: \'ES 9014\',\\n      originStation: \'London St Pancras Intl\',\\n      destinationStation: \'Paris Gare du Nord\',\\n      departureTime: \'09:31\',\\n      arrivalTime: \'12:47\',\\n      inVehicleHours: 2.27,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 1