      key: "questions"
      value: "[{\"question\":\"This workspace runs React + Vite + Express on port 3000. How should we structure Astris Travel so your preview works immediately?\",\"options\":[\"(Recommended) Live React + Express app with FastAPI/Pydantic models\",\"Strict Next.js + FastAPI monorepo files only\",\"Live React + Vite UI with Express API only\"]},{\"question\":\"Mapbox GL requires a private access token to load map tiles. Which mapping setup do you prefer for the interactive world map?\",\"options\":[\"(Recommended) Token-free MapLibre GL with great-circle arcs\",\"Mapbox GL with environment token configuration\",\"Google Maps Platform integration\"]},{\"question\":\"For this build, how complete should the interactive timeline, Smart Score engine, and voucher matcher be?\",\"options\":[\"(Recommended) Full interactive split-screen workspace with mock dataset\",\"Models, schemas, and minimal preview shell only\"]},{\"question\":\"How should trip data and transit options be stored in this initial phase?\",\"options\":[\"(Recommended) Mock dataset + Express API endpoints first\",\"Set up PostgreSQL database persistence immediately\"]}]"
    }
