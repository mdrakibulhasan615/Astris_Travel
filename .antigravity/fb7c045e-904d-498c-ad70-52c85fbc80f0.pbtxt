        target_content: "export type TransitMode = \'flight\' | \'train\' | \'bus\';\n\nexport type ModeFilter = \'all\' | TransitMode;\n\nexport type VttsTier = \'backpacker\' | \'explorer\' | \'express\' | \'custom\';\n\nexport interface VttsPreset {\n  id: Exclude<VttsTier, \'custom\'>;\n  label: string;\n  shortLabel: string;\n  hourlyRateUsd: number;\n  description: string;\n}\n\nexport interface SmartScoreBreakdown {\n  basePriceUsd: number;\n  discountAppliedUsd: number;\n  discountedPriceUsd: number;\n  hourlyRateUsd: number;\n  inVehicleHours: number;\n  modeMultiplier: number;\n  inVehiclePenaltyUsd: number;\n  layoverHours: number;\n  layoverMultiplier: number;\n  layoverPenaltyUsd: number;\n  totalSmartScore: number;\n}\n\nexport interface DestinationHub {\n  id: string;\n  city: string;\n  country: string;\n  iataCode: string;\n  lat: number;\n  lng: number;\n  region: string;\n  recommendedNights: number;\n  tagline: string;\n}\n\nexport interface TripStop {\n  id: string;\n  order: number;\n  city: string;\n  country: string;\n  iataCode: string;\n  lat: number;\n  lng: number;\n  stayNights: number;\n  arrivalDate: string;\n  departureDate: string;\n  notes?: string;\n}\n\nexport interface TransitOption {\n  id: string;\n  legId?: string;\n  mode: TransitMode;\n  isOvernightSleeper: boolean;\n  carrier: string;\n  carrierCode: string;\n  routeCode: string;\n  originStation: string;\n  destinationStation: string;\n  departureTime: string;\n  arrivalTime: string;\n  inVehicleHours: number;\n  layoverHours: number;\n  layoverHub?: string;\n  stopsCount: number;\n  basePriceUsd: number;\n  discountedPriceUsd: number;\n  smartScore: number;\n  smartScoreBreakdown: SmartScoreBreakdown;\n  doorToDoorNotes: string;\n  co2Kg: number;\n  eligibleVoucherIds: string[];\n  appliedVoucherId?: string | null;\n}\n\nexport interface TripLeg {\n  id: string;\n  fromStopId: string;\n  toStopId: string;\n  fromCity: string;\n  fromCode: string;\n  toCity: string;\n  toCode: string;\n  distanceKm: number;\n  selectedOptionId: string;\n  transitOptions: TransitOption[];\n}\n\nexport interface Voucher {\n  id: string;\n  code: string;\n  title: string;\n  discountType: \'percentage\' | \'fixed\';\n  discountValue: number;\n  maxDiscountUsd?: number;\n  minSpendUsd: number;\n  applicableModes: TransitMode[];\n  applicableCarriers?: string[];\n  expiresAt: string;\n  description: string;\n}\n\nexport interface Trip {\n  id: string;\n  title: string;\n  travelers: number;\n  currency: \'USD\';\n  vttsTier: VttsTier;\n  hourlyTimeValue: number;\n  stops: TripStop[];\n  legs: TripLeg[];\n  appliedVoucherCodes: string[];\n}"
        replacement_content: "export type TransitMode = \'flight\' | \'train\' | \'bus\' | \'ferry\';\n\nexport type ModeFilter = \'all\' | TransitMode;\n\nexport type VttsTier = \'backpacker\' | \'explorer\' | \'express\' | \'custom\';\n\nexport interface UserProfile {\n  id: string;\n  email: string;\n  fullName?: string;\n  preferredCurrency: string;\n  timeValuePerHour: number;\n  createdAt?: string;\n}\n\nexport interface VttsPreset {\n  id: Exclude<VttsTier, \'custom\'>;\n  label: string;\n  shortLabel: string;\n  hourlyRateUsd: number;\n  description: string;\n}\n\nexport interface SmartScoreBreakdown {\n  basePriceUsd: number;\n  discountAppliedUsd: number;\n  discountedPriceUsd: number;\n  hourlyRateUsd: number;\n  inVehicleHours: number;\n  modeMultiplier: number;\n  inVehiclePenaltyUsd: number;\n  layoverHours: number;\n  layoverMultiplier: number;\n  layoverPenaltyUsd: number;\n  totalSmartScore: number;\n}\n\nexport interface DestinationHub {\n  id: string;\n  city: string;\n  country: string;\n  iataCode: string;\n  lat: number;\n  lng: number;\n  region: string;\n  recommendedNights: number;\n  tagline: string;\n}\n\nexport interface TripStop {\n  id: string;\n  order: number;\n  city: string;\n  country: string;\n  iataCode: string;\n  lat: number;\n  lng: number;\n  stayNights: number;\n  arrivalDate: string;\n  departureDate: string;\n  notes?: string;\n}\n\nexport interface TransitOption {\n  id: string;\n  legId?: string;\n  mode: TransitMode;\n  isOvernightSleeper: boolean;\n  carrier: string;\n  carrierCode: string;\n  routeCode: string;\n  originStation: string;\n  destinationStation: string;\n  departureTime: string;\n  arrivalTime: string;\n  inVehicleHours: number;\n  layoverHours: number;\n  layoverHub?: string;\n  stopsCount: number;\n  basePriceUsd: number;\n  discountedPriceUsd: number;\n  smartScore: number;\n  smartScoreBreakdown: SmartScoreBreakdown;\n  doorToDoorNotes: string;\n  co2Kg: number;\n  bookingUrl?: string;\n  expiresAt?: string;\n  eligibleVoucherIds: string[];\n  appliedVoucherId?: string | null;\n}\n\nexport interface TripLeg {\n  id: string;\n  fromStopId: string;\n  toStopId: string;\n  fromCity: string;\n  fromCode: string;\n  toCity: string;\n  toCode: string;\n  distanceKm: number;\n  selectedOptionId: string;\n  transitOptions: TransitOption[];\n}\n\nexport interface Voucher {\n  id: string;\n  code: string;\n  providerName?: string;\n  platformSource?: string;\n  title: string;\n  discountType: \'percentage\' | \'fixed\';\n  discountValue: number;\n  maxDiscountUsd?: number;\n  minSpendUsd: number;\n  applicableModes: TransitMode[];\n  applicableCarriers?: string[];\n  validFrom?: string;\n  expiresAt: string;\n  isActive?: boolean;\n  description: string;\n}\n\nexport interface Trip {\n  id: string;\n  userId?: string;\n  title: string;\n  startDate?: string;\n  endDate?: string;\n  travelers: number;\n  currency: \'USD\';\n  isRouteOptimized?: boolean;\n  vttsTier: VttsTier;\n  hourlyTimeValue: number;\n  stops: TripStop[];\n  legs: TripLeg[];\n  appliedVoucherCodes: string[];\n}"
