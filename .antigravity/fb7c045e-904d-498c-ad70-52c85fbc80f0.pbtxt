            lines {
              text: "function formatArrivalFromHours(totalHours: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const days = Math.floor(totalHours / 24);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const rem = totalHours % 24;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const hrs = Math.floor(rem);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const mins = Math.round((rem - hrs) * 60) % 60;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const hh = String(hrs).padStart(2, \'0\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
