     routeCode: \'FX 704\',\n      originStation: \'London Victoria Coach Stn\',\n      destinationStation: \'Paris Bercy Seine\',\n      departureTime: \'08:00\',\n      arrivalTime: \'17:30\',\n      inVehicleHours: 8.5,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 38,\n      doorToDoorNotes: \'Victoria Coach \342\206\222 Dover/Calais \342\206\222 Amiens \342\206\222 Paris Bercy Seine\',\n      co2Kg: 18,\n      eligibleVoucherIds: [\'v-coach10\'],\n      segments: [\n        {\n          id: \'lon-par-fx-s1\',\n          mode: \'bus\',\n          label: \'FlixBus 704\',\n          fromName: \'London Victoria\',\n          fromCode: \'LON\',\n          fromLat: 51.5072,\n          fromLng: -0.1276,\n          toName: \'Paris Bercy Seine\',\n          toCode: \'PAR\',\n          toLat: 48.8566,\n          toLng: 2.3522,\n          durationMinutes: 510,\n          waypoints: [\n            [-0.1276, 51.5072],\n            [0.52, 51.27],\n            [1.3134, 51.1279],\n            [1.8587, 50.9513],\n            [2.2957, 49.8941],\n            [2.3522, 48.8566],\n          ],\n        },\n      ],\n    }),\n    makeBaseOption({\n      id: \'lon-par-blabla-sleeper\',\n      mode: \'bus\',\n      isOvernightSleeper: true,\n      carrier: \'BlaBlaCar Night Coach\',\n      carrierCode: \'BB\',\n      routeCode: \'BB 918\',\n      originStation: \'London Victoria Coach Stn\',\n      destinationStation: \'Paris Bercy Seine\',\n      departureTime: \'22:30\',\n      arrivalTime: \'07:45 +1d\',\n      inVehicleHours: 8.25,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 46,\n      doorToDoorNotes: \'Overnight sleeper coach via Eurotunnel \342\206\222 Paris Bercy Seine\',\n      co2Kg: 17,\n      eligibleVoucherIds: [\'v-coach10\'],\n      segments: [\n        {\n          id: \'lon-par-bb-s1\',\n          mode: \'bus\',\n          label: \'BlaBlaCar Night\',\n          fromName: \'London Victoria\',\n          fromCode: \'LON\',\n          fromLat: 51.5072,\n          fromLng: -0.1276,\n          toName: \'Paris Bercy Seine\',\n          toCode: \'PAR\',\n          toLat: 48.8566,\n          toLng: 2.3522,\n          durationMinutes: 495,\n          waypoints: [\n            [-0.1276, 51.5072],\n            [1.147, 51.0924],\n            [1.811, 50.9016],\n            [2.3, 49.45],\n            [2.3522, 48.8566],\n          ],\n        },\n      ],\n    }),\n  ],\n  \'PAR-LON\': [\n    makeBaseOption({\n      id: \'par-lon-es-direct\',\n      mode: \'train\',\n      isOvernightSleeper: false,\n      carrier: \'Eurostar\',\n      carrierCode: \'ES\',\n      routeCode: \'ES 9023\',\n      originStation: \'Paris Gare du Nord\',\n      destinationStation: \'London St Pancras Intl\',\n      departureTime: \'11:13\',\n      arrivalTime: \'12:30\',\n      inVehicleHours: 2.28,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 122,\n      doorToDoorNotes: \'Paris Gare du Nord \342\206\222 Channel Tunnel \342\206\222 London St Pancras\',\n      co2Kg: 6,\n      eligibleVoucherIds: [\'v-railpass20\'],\n      segments: [\n        {\n          id: \'par-lon-es-s1\',\n          mode: \'train\',\n          label: \'Eurostar ES 9023\',\n          fromName: \'Paris Gare du Nord\',\n          fromCode: \'PAR\',\n          fromLat: 48.8566,\n          fromLng: 2.3522,\n          toName: \'London St Pancras\',\n          toCode: \'LON\',\n          toLat: 51.5072,\n          toLng: -0.1276,\n          durationMinutes: 137,\n          waypoints: [\n            [2.3522, 48.8566],\n            [2.412, 49.941],\n            [1.811, 50.9016],\n            [1.147, 51.0924],\n            [0.3208, 51.443],\n            [-0.1276, 51.5072],\n          ],\n        },\n      ],\n    }),\n    makeBaseOption({\n      id: \'par-lon-fx-bus\',\n      mode: \'bus\',\n      isOvernightSleeper: false,\n      carrier: \'FlixBus Cross-Channel\',\n      carrierCode: \'FX\',\n      routeCode: \'FX 709\',\n      originStation: \'Paris Bercy Seine\',\n      destinationStation: \'London Victoria Coach Stn\',\n      departureTime: \'09:15\',\n      arrivalTime: \'17:45\',\n      inVehicleHours: 8.5,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 39,\n      doorToDoorNotes: \'Paris Bercy Seine \342\206\222 Calais/Dover \342\206\222 London Victoria\',\n      co2Kg: 18,\n      eligibleVoucherIds: [\'v-coach10\'],\n      segments: [\n        {\n          id: \'par-lon-fx-s1\',\n          mode: \'bus\',\n          label: \'FlixBus 709\',\n          fromName: \'Paris Bercy Seine\',\n          fromCode: \'PAR\',\n          fromLat: 48.8566,\n          fromLng: 2.3522,\n          toName: \'London Victoria\',\n          toCode: \'LON\',\n          toLat: 51.5072,\n          toLng: -0.1276,\n          durationMinutes: 510,\n          waypoints: [\n            [2.3522, 48.8566],\n            [2.2957, 49.8941],\n            [1.8587, 50.9513],\n            [1.3134, 51.1279],\n            [-0.1276, 51.5072],\n          ],\n        },\n      ],\n    }),\n  ],\n  \'IST-PAR\': [\n    makeBaseOption({\n      id: \'ist-par-tk-direct\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Turkish Airlines\',\n      carrierCode: \'TK\',\n      routeCode: \'TK 1823\',\n      originStation: \'Istanbul Airport (IST)\',\n      destinationStation: \'Paris Charles de Gaulle (CDG)\',\n      departureTime: \'11:15\',\n      arrivalTime: \'13:55\',\n      inVehicleHours: 3.67,\n      layoverHours: 0,\n      stopsCount: 0,\n      basePriceUsd: 204,\n      doorToDoorNotes: \'M11 Metro 38m \342\206\222 TK 1823 3h 40m \342\206\222 RER B 35m\',\n      co2Kg: 242,\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\n      segments: [\n        {\n          id: \'ist-par-tk-s1\',\n          mode: \'train\',\n          label: \'M11 Metro\',\n          fromName: \'Istanbul Center\',\n          fromCode: \'IST\',\n          fromLat: 41.0082,\n          fromLng: 28.9784,\n          toName: \'IST Airport\',\n          toCode: \'IST\',\n          toLat: 41.2753,\n          toLng: 28.7519,\n          durationMinutes: 38,\n        },\n        {\n          id: \'ist-par-tk-s2\',\n          mode: \'flight\',\n          label: \'TK 1823\',\n          fromName: \'Istanbul (IST)\',\n          fromCode: \'IST\',\n          fromLat: 41.2753,\n          fromLng: 28.7519,\n          toName: \'Paris CDG\',\n          toCode: \'CDG\',\n          toLat: 49.0097,\n          toLng: 2.5479,\n          durationMinutes: 220,\n        },\n        {\n          id: \'ist-par-tk-s3\',\n          mode: \'train\',\n          label: \'RER B\',\n          fromName: \'Paris CDG\',\n          fromCode: \'CDG\',\n          fromLat: 49.0097,\n          fromLng: 2.5479,\n          toName: \'Paris Center\',\n          toCode: \'PAR\',\n          toLat: 48.8566,\n          toLng: 2.3522,\n          durationMinutes: 35,\n        },\n      ],\n    }),\n    makeBaseOption({\n      id: \'ist-par-pc-1stop\',\n      mode: \'flight\',\n      isOvernightSleeper: false,\n      carrier: \'Pegasus Airlines\',\n      carrierCode: \'PC\',\n      routeCode: \'PC 1133\',\n      originStation: \'Sabiha Gokcen (SAW)\',\n      destinationStation: \'Paris Orly (ORY)\',\n      departureTime: \'09:40\',\n      arrivalTime: \'16:10\',\n      inVehicleHours: 4.1,\n      layoverHours: 2.4,\n      layoverHub: \'AYT\',\n      stopsCount: 1,\n      basePriceUsd: 146,\n      doorToDoorNotes: \'SAW \342\206\222 Antalya (2h 24m) \342\206\222 Paris Orly \342\206\222 Orlyval 28m\',\n      co2Kg: 265,\n      eligibleVoucherIds: [\'v-astris15\'],\n      segments: [\n        {\n          id: \'ist-par-pc-s1\',\n          mode: \'flight\',\n          label: \'PC 2010\',\n          fromName: \'Sabiha Gokcen (SAW)\',\n          fromCode: \'SAW\',\n          fromLat: 40.8986,\n          fromLng: 29.3092,\n          toName: \'Antalya (AYT)\',\n          toCode: \'AYT\',\n          toLat: 36.8987,\n          to