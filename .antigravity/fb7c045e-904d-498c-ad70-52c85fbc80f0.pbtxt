  view_file {
    absolute_path_uri: "file:///src/components/MultiDestDatePickerModal.tsx"
    end_line: 424
    content: "import { useEffect, useMemo, useState } from \'react\';\nimport { Calendar, ChevronLeft, ChevronRight, X } from \'lucide-react\';\nimport {\n  addDaysIso,\n  diffDaysIso,\n  formatIsoUtc,\n  formatShortDate,\n  getStopColorMap,\n  parseIsoUtc,\n} from \'../../shared/dateUtils.ts\';\nimport type { TripStop } from \'../../shared/types.ts\';\n\ninterface MultiDestDatePickerModalProps {\n  isOpen: boolean;\n  stops: TripStop[];\n  initialStopId: string | null;\n  onClose: () => void;\n  onUpdateStopDates: (stopId: string, arrivalDate: string, departureDate: string) => void;\n}\n\nconst WEEKDAYS = [\'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\', \'Sun\'];\n\nfunction getMonthGrid(year: number, monthZeroBased: number): Array<{ iso: string; inMonth: boolean }> {\n  const firstOfMonth = new Date(Date.UTC(year, monthZeroBased, 1));\n  // Convert Sunday=0..Saturday=6 to Monday=0..Sunday=6\n  const startDayOfWeek = (firstOfMonth.getUTCDay() + 6) % 7;\n  const gridStart = new Date(Date.UTC(year, monthZeroBased, 1 - startDayOfWeek));\n\n  const cells: Array<{ iso: string; inMonth: boolean }> = [];\n  for (let i = 0; i < 42; i++) {\n    const dt = new Date(gridStart.getTime() + i * 86_400_000);\n    cells.push({\n      iso: formatIsoUtc(dt),\n      inMonth: dt.getUTCMonth() === monthZeroBased,\n    });\n  }\n  return cells;\n}\n\nexport function MultiDestDatePickerModal({\n  isOpen,\n  stops,\n  initialStopId,\n  onClose,\n  onUpdateStopDates,\n}: MultiDestDatePickerModalProps) {\n  const [selectedStopId, setSelectedStopId] = useState<string>(\n    initialStopId ?? stops[0]?.id ?? \'\'\n  );\n  const [draftStartIso, setDraftStartIso] = useState<string | null>(null);\n  const [hoverIso, setHoverIso] = useState<string | null>(null);\n\n  const activeStop =\n    stops.find((s) => s.id === selectedStopId) ?? stops[0] ?? null;\n\n  const [viewMonth, setViewMonth] = useState<{ year: number; month: number }>(() => {\n    const seed = activeStop?.arrivalDate ?? \'2026-11-18\';\n    const dt = parseIsoUtc(seed);\n    return { year: dt.getUTCFullYear(), month: dt.getUTCMonth() };\n  });\n\n  // Sync active stop & visible month when opened from a specific stop card\n  useEffect(() => {\n    if (!isOpen) return;\n    const targetId = initialStopId ?? stops[0]?.id ?? \'\';\n    setSelectedStopId(targetId);\n    setDraftStartIso(null);\n    setHoverIso(null);\n    const targetStop = stops.find((s) => s.id === targetId) ?? stops[0];\n    if (targetStop) {\n      const dt = parseIsoUtc(targetStop.arrivalDate);\n      setViewMonth({ year: dt.getUTCFullYear(), month: dt.getUTCMonth() });\n    }\n  }, [isOpen, initialStopId, stops]);\n\n  const stopColorMap = useMemo(\n    () => getStopColorMap(stops, activeStop?.id ?? null),\n    [stops, activeStop?.id]\n  );\n\n  // Map each ISO day to the stop whose booked nights cover that date [arrivalDate, departureDate)\n  const dayAllocationMap = useMemo(() => {\n    const map: Record<\n      string,\n      {\n        stop: TripStop;\n        color: string;\n        isStart: boolean;\n        isEndNight: boolean;\n        isCheckoutDay: boolean;\n      }\n    > = {};\n\n    // Populate non-active stops first so the currently selected stop takes visual priority\n    const orderedForPaint = [\n      ...stops.filter((s) => s.id !== activeStop?.id),\n      ...(activeStop ? [activeStop] : []),\n    ];\n\n    for (const stop of orderedForPaint) {\n      const color = stopColorMap[stop.id] ?? \'#FF812E\';\n      const nights = Math.max(1, diffDaysIso(stop.arrivalDate, stop.departureDate));\n      for (let n = 0; n < nights; n++) {\n        const iso = addDaysIso(stop.arrivalDate, n);\n        map[iso] = {\n          stop,\n          color,\n          isStart: n === 0,\n          isEndNight: n === nights - 1,\n          isCheckoutDay: false,\n        };\n      }\n    }\n    return map;\n  }, [stops, activeStop, stopColorMap]);\n\n  if (!isOpen || stops.length === 0) return null;\n\n  const monthTitle = new Date(Date.UTC(viewMonth.year, viewMonth.month, 1)).toLocaleDateString(\n    \'en-US\',\n    { month: \'long\', year: \'numeric\', timeZone: \'UTC\' }\n  );\n\n  const monthCells = getMonthGrid(viewMonth.year, viewMonth.month);\n\n  const shiftMonth = (delta: number) => {\n    const dt = new Date(Date.UTC(viewMonth.year, viewMonth.month + delta, 1));\n    setViewMonth({ year: dt.getUTCFullYear(), month: dt.getUTCMonth() });\n  };\n\n  const handleSelectStopTab = (stop: TripStop) => {\n    setSelectedStopId(stop.id);\n    setDraftStartIso(null);\n    setHoverIso(null);\n    const dt = parseIsoUtc(stop.arrivalDate);\n    setViewMonth({ year: dt.getUTCFullYear(), month: dt.getUTCMonth() });\n  };\n\n  const handleDayClick = (iso: string) => {\n    if (!activeStop) return;\n\n    if (!draftStartIso) {\n      // First click begins range selection for the active stop\n      setDraftStartIso(iso);\n      return;\n    }\n\n    if (iso <= draftStartIso) {\n      // Clicked same or earlier day: treat as 1-night stay starting on clicked date if same, else restart range\n      if (iso === draftStartIso) {\n        onUpdateStopDates(activeStop.id, iso, addDaysIso(iso, 1));\n        setDraftStartIso(null);\n        setHoverIso(null);\n      } else {\n        setDraftStartIso(iso);\n      }\n      return;\n    }\n\n    // Second click sets departureDate (arrivalDate -> iso) and cascades subsequent stops\n    onUpdateStopDates(activeStop.id, draftStartIso, iso);\n    setDraftStartIso(null);\n    setHoverIso(null);\n  };\n\n  // Preview range while selecting second date\n  const previewEndIso =\n    draftStartIso && hoverIso && hoverIso > draftStartIso ? hoverIso : null;\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Multi-destination trip date picker\"\n      onClick={onClose}\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/25 backdrop-blur-xs\"\n    >\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-md bg-white border border-slate-200/80 shadow-xl rounded-2xl overflow-hidden\"\n      >\n        {/* Header */}\n        <div className=\"px-5 py-4 border-b border-slate-100 flex items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"w-8 h-8 rounded-xl bg-[#FFF4ED] border border-[#FFD6BA] text-[#FF812E] flex items-center justify-center\">\n              <Calendar className=\"w-4 h-4\" />\n            </span>\n            <div>\n              <h2 className=\"font-display text-base font-bold text-[#111827]\">\n                Itinerary Dates\n              </h2>\n              {activeStop && (\n                <div className=\"text-xs font-mono text-[#4B5563] tabular-nums\">\n                  {activeStop.city}: {formatShortDate(activeStop.arrivalDate)} \342\206\222{\' \'}\n                  {formatShortDate(activeStop.departureDate)} ({activeStop.stayNights}n)\n                </div>\n              )}\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            aria-label=\"Close calendar\"\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-xl flex items-center justify-center text-[#4B5563] hover:text-[#111827] hover:bg-slate-100 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Active Stop Selector Tabs */}\n        <div className=\"px-5 pt-3.5 pb-2 flex items-center gap-1.5 overflow-x-auto astris-scroll\">\n          {stops.map((stop, idx) => {\n            const isSelected = stop.id === activeStop?.id;\n            const color = stopColorMap[stop.id] ?? \'#FF812E\';\n            return (\n              <button\n                key={stop.id}\n                type=\"button\"\n                onClick={() => handleSelectStopTab(stop)}\n                className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap shrink-0 border transition-all cursor-pointer ${\n                  isSelected\n                    ? \'bg-[#FFF4ED] border-[#FFD6BA] text-[#111827] shadow-xs\'\n                    : \'bg-white border-slate-200/80 text-[#4B5563] hover:text-[#111827] hover:border-slate-300\'\n                }`}\n              >\n                <span\n                  className=\"w-2 h-2 rounded-full shrink-0\"\n                  style={{ backgroundColor: color }}\n                />\n                <span>\n                  {idx + 1}. {stop.city}\n                </span>\n                <span className=\"font-mono text-[11px] text-[#4B5563] tabular-nums\">\n                  {stop.stayNights}n\n                </span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Calendar Month Navigation & Grid */}\n        <div className=\"px-5 py-3 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <button\n              type=\"button\"\n              aria-label=\"Previous month\"\n              onClick={() => shiftMonth(-1)}\n              className=\"w-8 h-8 rounded-xl border border-slate-200/80 flex items-center justify-center text-[#4B5563] hover:text-[#111827] hover:bg-slate-50 transition-colors cursor-pointer\"\n            >\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n\n            <h3 className=\"font-display text-sm font-bold text-[#111827]\">\n              {monthTitle}\n            </h3>\n\n            <button\n              type=\"button\"\n              aria-label=\"Next month\"\n              onClick={() => shiftMonth(1)}\n              className=\"w-8 h-8 rounded-xl border border-slate-200/80 flex items-center justify-center text-[#4B5563] hover:text-[#111827] hover:bg-slate-50 transition-colors cursor-pointer\"\n            >\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Weekday Headers */}\n          <div className=\"grid grid-cols-7 gap-1 text-center\">\n            {WEEKDAYS.map((day) => (\n              <div\n                key={day}\n                className=\"text-[11px] font-medium text-[#4B5563] py-1\"\n              >\n                {day}\n              </div>\n            ))}\n          </div>\n\n          {/* 42-Day Calendar Matrix */}\n          <div className=\"grid grid-cols-7 gap-y-1\">\n            {monthCells.map(({ iso, inMonth }) => {\n              const dayNum = Number(iso.slice(-2));\n              const alloc = dayAllocationMap[iso];\n              const isDraftStart = draftStartIso === iso;\n              const isInDraftPreview =\n                draftStartIso !== null &&\n                previewEndIso !== null &&\n                iso >= draftStartIso &&\n                iso < previewEndIso;\n              const isDraftEnd = previewEndIso === iso;\n              const isActiveCheckout =\n                !draftStartIso && activeStop?.departureDate === iso;\n\n              let bgStyle: string | undefined;\n              let textColor = inMonth ? \'#111827\' : \'#9CA3AF\';\n              let pillRadius = \'rounded-full\';\n              let ringClass = \'\';\n\n              if (isDraftStart || isInDraftPreview || isDraftEnd) {\n                bgStyle = isDraftStart || isDraftEnd ? \'#FF812E\' : \'#FFF4ED\';\n                textColor = isDraftStart || isDraftEnd ? \'#FFFFFF\' : \'#C2410C\';\n                if (isDraftStart && previewEndIso) pillRadius = \'rounded-l-full\';\n                else if (isDraftEnd) pillRadius = \'rounded-r-full\';\n                else if (isInDraftPreview) pillRadius = \'rounded-none\';\n              } else if (alloc) {\n                const isActiveStopDay = alloc.stop.id === activeStop?.id;\n                if (alloc.isStart || alloc.isEndNight) {\n                  bgStyle = alloc.color;\n                  textColor = \'#FFFFFF\';\n                } else {\n                  bgStyle = isActiveStopDay ? \'#FFF4ED\' : `${alloc.color}1A`;\n                  textColor = isActiveStopDay ? \'#C2410C\' : \'#111827\';\n                }\n\n                if (alloc.isStart && alloc.isEndNight) {\n                  pillRadius = \'rounded-full\';\n                } else if (alloc.isStart) {\n                  pillRadius = \'rounded-l-full\';\n                } else if (alloc.isEndNight) {\n                  pillRadius = \'rounded-r-full\';\n                } else {\n                  pillRadius = \'rounded-none\';\n                }\n              }\n\n              if (isActiveCheckout && !alloc) {\n                ringClass = \'ring-1.5 ring-[#FF812E] text-[#E56B1A]\';\n              }\n\n              return (\n                <button\n                  key={iso}\n                  type=\"button\"\n                  onMouseEnter={() => {\n                    if (draftStartIso) setHoverIso(iso);\n                  }}\n                  onClick={() => handleDayClick(iso)}\n                  title={\n                    alloc\n                      ? `${alloc.stop.city} (${alloc.stop.arrivalDate} \342\206\222 ${alloc.stop.departureDate})`\n                      : iso\n                  }\n                  style={{\n                    backgroundColor: bgStyle,\n                    color: textColor,\n                  }}\n                  className={`h-9 flex items-center justify-center font-mono text-xs font-medium tabular-nums transition-colors cursor-pointer ${pillRadius} ${ringClass} ${\n                    !bgStyle ? \'hover:bg-slate-100\' : \'\'\n                  }`}\n                >\n                  {dayNum}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Selection status telemetry */}\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-[#4B5563] pt-1 tabular-nums\">\n            <span>\n              {draftStartIso\n                ? previewEndIso\n                  ? `${formatShortDate(draftStartIso)} \342\206\222 ${formatShortDate(\n                      previewEndIso\n                    )} (${diffDaysIso(draftStartIso, previewEndIso)}n)`\n                  : `Check-in ${formatShortDate(draftStartIso)} \302\267 Pick check-out`\n                : activeStop\n                  ? `Editing ${activeStop.city} \302\267 Click start & end date`\n                  : \'\'}\n            </span>\n            {draftStartIso && (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setDraftStartIso(null);\n                  setHoverIso(null);\n                }}\n                className=\"text-[#E56B1A] font-semibold hover:underline cursor-pointer\"\n              >\n                Cancel\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Horizontal Color-Dot City Legend */}\n        <div className=\"px-5 py-3.5 bg-[#FAFAFA] border-t border-slate-100 flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex flex-wrap items-center gap-x-3.5 gap-y-1.5\">\n            {stops.map((stop) => {\n              const color = stopColorMap[stop.id] ?? \'#FF812E\';\n              const isSelected = stop.id === activeStop?.id;\n              return (\n                <button\n                  key={stop.id}\n                  type=\"button\"\n                  onClick={() => handleSelectStopTab(stop)}\n                  className={`inline-flex items-center gap-1.5 text-xs transition-colors cursor-pointer ${\n                    isSelected\n                      ? \'font-semibold text-[#111827]\'\n                      : \'font-medium text-[#4B5563] hover:text-[#111827]\'\n                  }`}\n                >\n                  <span\n                    className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                    style={{ backgroundColor: color }}\n                  />\n                  <span>{stop.city}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-3.5 py-1.5 rounded-xl bg-[#FF812E] hover:bg-[#E56B1A] text-white text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 425
    num_bytes: 15830
    line_range_bytes: 15830
  }
}
