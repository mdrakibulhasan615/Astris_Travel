            }
            lines {
              text: "    setMobileView(\'split-left\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (panel === \'smart-score\' && smartScoreSectionRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      smartScoreSectionRef.current.scrollIntoView({ behavior: \'smooth\', block: \'start\' });"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else if (panel === \'timeline\' && timelineSectionRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      timelineSectionRef.current.scrollIntoView({ behavior: \'smooth\', block: \'start\' });"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
