          target_content: "          {/* 42-Day Calendar Matrix */}\n          <div className=\"grid grid-cols-7 gap-y-1\">\n            {monthCells.map(({ iso, inMonth }) => {\n              const dayNum = Number(iso.slice(-2));\n              const alloc = dayAllocationMap[iso];\n              const isDraftStart = draftStartIso === iso;\n              const isInDraftPreview =\n                draftStartIso !== null &&\n                previewEndIso !== null &&\n                iso >= draftStartIso &&\n                iso < previewEndIso;\n              const isDraftEnd = previewEndIso === iso;\n              const isActiveCheckout =\n                !draftStartIso && activeStop?.departureDate === iso;\n\n              let bgStyle: string | undefined;\n              let textColor = inMonth ? \'#111827\' : \'#9CA3AF\';\n              let pillRadius = \'rounded-full\';\n              let boxShadowStyle: string | undefined;\n              let fontWeightClass = \'font-medium\';\n\n              if (isDraftStart || isInDraftPreview || isDraftEnd) {\n                bgStyle =\n                  isDraftStart || isDraftEnd ? activeColor : `${activeColor}1F`;\n                textColor =\n                  isDraftStart || isDraftEnd ? \'#FFFFFF\' : \'#111827\';\n                fontWeightClass =\n                  isDraftStart || isDraftEnd ? \'font-bold\' : \'font-semibold\';\n                if (isDraftStart && previewEndIso) pillRadius = \'rounded-l-full\';\n                else if (isDraftEnd) pillRadius = \'rounded-r-full\';\n                else if (isInDraftPreview) pillRadius = \'rounded-none\';\n\n                if (isDraftStart || isDraftEnd) {\n                  boxShadowStyle = `0 0 0 1.5px #FFFFFF, 0 0 0 3.5px ${activeColor}`;\n                }\n              } else if (alloc) {\n                const isActiveStopDay = alloc.stop.id === activeStop?.id;\n                if (alloc.isStart || alloc.isEndNight) {\n                  bgStyle = alloc.color;\n       