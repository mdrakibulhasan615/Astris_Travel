  code_action {
    action_spec {
      create_file {
        instruction: "import { useState } from \'react\';\nimport { ChevronDown, ChevronUp, SlidersHorizontal } from \'lucide-react\';\nimport { VTTS_PRESETS } from \'../../shared/smartScore.ts\';\nimport type { VttsTier } from \'../../shared/types.ts\';\n\ninterface VttsControlPanelProps {\n  vttsTier: VttsTier;\n  hourlyTimeValue: number;\n  totalCostUsd: number;\n  totalSavingsUsd: number;\n  totalHours: number;\n  totalSmartScore: number;\n  totalDistanceKm: number;\n  onSelectPreset: (tier: Exclude<VttsTier, \'custom\'>, hourlyRateUsd: number) => void;\n  onChangeCustomRate: (hourlyRateUsd: number) => void;\n}\n\nexport function VttsControlPanel({\n  vttsTier,\n  hourlyTimeValue,\n  totalCostUsd,\n  totalSavingsUsd,\n  totalHours,\n  totalSmartScore,\n  totalDistanceKm,\n  onSelectPreset,\n  onChangeCustomRate,\n}: VttsControlPanelProps) {\n  const [showAdvancedSlider, setShowAdvancedSlider] = useState(false);\n\n  return (\n    <section\n      aria-label=\"Trip summary and VTTS controls\"\n      className=\"bg-white rounded-2xl border border-neutral-200/80 shadow-sm p-4 space-y-3.5\"\n    >\n      {/* Compact tabular KPI strip */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 pb-3.5 border-b border-neutral-100\">\n        <div>\n          <div className=\"text-[11px] font-medium text-[#4B5563]\">Net Fare</div>\n          <div className=\"mt-0.5 flex items-baseline gap-1.5\">\n            <span className=\"font-display text-lg font-bold text-[#111827] tabular-nums\">\n              ${totalCostUsd.toFixed(0)}\n            </span>\n            {totalSavingsUsd > 0 && (\n              <span className=\"text-[11px] font-medium text-[#16A34A] tabular-nums\">\n                -${totalSavingsUsd.toFixed(0)}\n              </span>\n            )}\n          </div>\n        </div>\n\n        <div>\n          <div className=\"text-[11px] font-medium text-[#4B5563]\">Transit Time</div>\n          <div className=\"mt-0.5 font-display text-lg font-bold text-[#111827] tabular-nums\">\n            {totalHours.toFixed(1)}h\n          </div>\n        </div>\n\n        <div>\n          <div className=\"text-[11px] font-medium text-[#4B5563]\">Smart Score</div>\n          <div className=\"mt-0.5 font-display text-lg font-bold text-[#E56B1A] tabular-nums\">\n            ${totalSmartScore.toFixed(0)}\n          </div>\n        </div>\n\n        <div>\n          <div className=\"text-[11px] font-medium text-[#4B5563]\">Distance</div>\n          <div className=\"mt-0.5 font-display text-lg font-bold text-[#111827] tabular-nums\">\n            {totalDistanceKm.toLocaleString()} km\n          </div>\n        </div>\n      </div>\n\n      {/* Tiered VTTS Controls */}\n      <div className=\"space-y-2.5\">\n        <div className=\"flex items-center justify-between gap-2\">\n          <h2 className=\"font-display text-xs font-semibold text-[#111827]\">\n            VTTS Time Valuation\n          </h2>\n\n          <button\n            type=\"button\"\n            onClick={() => setShowAdvancedSlider((prev) => !prev)}\n            className=\"inline-flex items-center gap-1.5 text-xs font-medium text-[#4B5563] hover:text-[#111827] px-2 py-1 rounded-lg hover:bg-neutral-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n            <span className=\"font-mono tabular-nums\">${hourlyTimeValue}/hr</span>\n            {showAdvancedSlider ? (\n              <ChevronUp className=\"w-3.5 h-3.5\" />\n            ) : (\n              <ChevronDown className=\"w-3.5 h-3.5\" />\n            )}\n          </button>\n        </div>\n\n        <div\n          role=\"radiogroup\"\n          aria-label=\"VTTS traveler tier preset\"\n          className=\"grid grid-cols-3 gap-1.5 p-1 bg-neutral-100 rounded-xl\"\n        >\n          {VTTS_PRESETS.map((preset) => {\n            const isActive = vttsTier === preset.id;\n            return (\n              <button\n                key={preset.id}\n                type=\"button\"\n                role=\"radio\"\n                aria-checked={isActive}\n                onClick={() => onSelectPreset(preset.id, preset.hourlyRateUsd)}\n                className={`px-3 py-1.5 rounded-lg text-left transition-all cursor-pointer ${\n                  isActive\n                    ? \'bg-[#FFF4ED] border border-[#FFD6BA] shadow-sm text-[#111827]\'\n                    : \'border border-transparent text-[#4B5563] hover:text-[#111827] hover:bg-white/60\'\n                }`}\n              >\n                <div className=\"text-xs font-semibold truncate\">{preset.label}</div>\n                <div\n                  className={`font-mono text-[11px] tabular-nums ${\n                    isActive ? \'text-[#E56B1A] font-semibold\' : \'text-[#4B5563]\'\n                  }`}\n                >\n                  ${preset.hourlyRateUsd}/hr\n                </div>\n              </button>\n            );\n          })}\n        </div>\n\n        {showAdvancedSlider && (\n          <div className=\"pt-2 space-y-1.5 border-t border-neutral-100\">\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"vtts-advanced-slider\" className=\"font-medium text-[#111827]\">\n                Custom Rate\n              </label>\n              <span className=\"font-mono font-semibold text-[#E56B1A] tabular-nums\">\n                ${hourlyTimeValue}/hr\n              </span>\n            </div>\n            <input\n              id=\"vtts-advanced-slider\"\n              type=\"range\"\n              min={0}\n              max={80}\n              step={1}\n              value={hourlyTimeValue}\n              onChange={(e) => onChangeCustomRate(Number(e.target.value))}\n              className=\"w-full accent-[#FF812E] cursor-pointer\"\n            />\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/VttsControlPanel.tsx"
        }
        overwrite: true
      }
    }
