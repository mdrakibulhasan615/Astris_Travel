            lines {
              text: "CREATE TABLE trips ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    user_id UUID REFERENCES users(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title VARCHAR(150) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    start_date DATE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    end_date DATE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    currency VARCHAR(3) DEFAULT \'USD\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    is_route_optimized BOOLEAN DEFAULT FALSE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 3. Trip Legs Table (Timeline stops + Map Coordinates)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE trip_legs ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    trip_id UUID REFERENCES trips(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    order_index INT NOT NULL, -- Sequence on timeline & numbered map pin (1, 2, 3...)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Origin Stop Details"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    origin_city VARCHAR(100) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    origin_code VARCHAR(10) NOT NULL, -- e.g., KUL"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    origin_lat DECIMAL(9, 6) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    origin_lng DECIMAL(9, 6) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Destination Stop Details"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    destination_city VARCHAR(100) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    destination_code VARCHAR(10) NOT NULL, -- e.g., IST"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    destination_lat DECIMAL(9, 6) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    destination_lng DECIMAL(9, 6) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Timing & Selection"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    departure_date DATE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    nights_at_destination INT DEFAULT 3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    selected_option_id UUID, -- References chosen TransitOption"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 4. Cached Transit Options (Flights, Trains, Buses, Ferries)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE transit_options ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    leg_id UUID REFERENCES trip_legs(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    transport_mode VARCHAR(20) CHECK (transport_mode IN (\'flight\', \'train\', \'bus\', \'ferry\')),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    provider_name VARCHAR(100) NOT NULL, -- e.g., Turkish Airlines, Eurostar"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Pricing & Vouchers"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    base_price DECIMAL(10, 2) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    discounted_price DECIMAL(10, 2),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    applied_voucher_id UUID,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    currency VARCHAR(3) DEFAULT \'USD\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Duration & Smart Score"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    departure_time TIMESTAMP WITH TIME ZONE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    arrival_time TIMESTAMP WITH TIME ZONE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    duration_minutes INT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    layover_minutes INT DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    stops_count INT DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    smart_score DECIMAL(10, 2) NOT NULL, -- Lower is better: price + (hours * time_value)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Booking & Cache TTL"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    booking_url TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    raw_api_payload JSONB,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 5. Vouchers & Discounts Table"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE vouchers ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    provider_name VARCHAR(100) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    platform_source VARCHAR(100), -- e.g., Trip.com, Klook, Direct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    promo_code VARCHAR(50) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    discount_type VARCHAR(20) CHECK (discount_type IN (\'percentage\', \'fixed\')),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    discount_value DECIMAL(10, 2) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    max_discount_cap DECIMAL(10, 2),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    min_spend DECIMAL(10, 2) DEFAULT 0.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    valid_from DATE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    valid_until DATE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    is_active BOOLEAN DEFAULT TRUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Foreign Key Constraints"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE trip_legs "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ADD CONSTRAINT fk_selected_option "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    FOREIGN KEY (selected_option_id) REFERENCES transit_options(id) ON DELETE SET NULL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE transit_options "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ADD CONSTRAINT fk_applied_voucher "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    FOREIGN KEY (applied_voucher_id) REFERENCES vouchers(id) ON DELETE SET NULL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Performance Indexes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_trip_legs_trip_order ON trip_legs(trip_id, order_index);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_transit_options_leg_score ON transit_options(leg_id, smart_score ASC);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_vouchers_active_provider ON vouchers(provider_name, is_active);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///backend/SCHEMA.sql"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Add PostgreSQL database schema (SCHEMA.sql) for users, trips, trip_legs, transit_options, and vouchers to backend/."
    diff_stats {
      additions: 109
    }
  }
}
