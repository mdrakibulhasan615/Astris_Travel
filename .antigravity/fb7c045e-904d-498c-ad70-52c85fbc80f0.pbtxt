  code_action {
    action_spec {
      command {
        instruction: "Update updateStopDatesAndCascade to clamp against preceding stop departureDate and sequentially recalculate all subsequent stops preserving non-negative transit gaps"
        is_edit: true
        file {
          absolute_uri: "file:///shared/dateUtils.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "/**\n * Updates a single stop\'s arrival/departure/nights and shifts all subsequent stops\n * by the departure date delta so transit gaps are preserved and dates never collide.\n */\nexport function updateStopDatesAndCascade(\n  stops: TripStop[],\n  targetStopId: string,\n  newArrivalDate: string,\n  newDepartureDate: string\n): TripStop[] {\n  const targetIdx = stops.findIndex((s) => s.id === targetStopId);\n  if (targetIdx === -1) return stops;\n\n  const oldStop = stops[targetIdx];\n  const stayNights = Math.max(1, diffDaysIso(newArrivalDate, newDepartureDate));\n  const resolvedDeparture = addDaysIso(newArrivalDate, stayNights);\n  const departureDelta = diffDaysIso(oldStop.departureDate, resolvedDeparture);\n\n  return stops.map((stop, idx) => {\n    if (idx < targetIdx) return stop;\n    if (idx === targetIdx) {\n      return {\n        ...stop,\n        arrivalDate: newArrivalDate,\n        departureDate: resolvedDeparture,\n        stayNights,\n      };\n    }\n    return {\n      ...stop,\n      arrivalDate: addDaysIso(stop.arrivalDate, departureDelta),\n      departureDate: addDaysIso(stop.departureDate, departureDelta),\n    };\n  });\n}"
          replacement_content: "/**\n * Updates a single stop\'s arrival/departure/nights while clamping against the preceding\n * stop\'s departureDate (preventing overlaps) and sequentially cascading all subsequent stops.\n */\nexport function updateStopDatesAndCascade(\n  stops: TripStop[],\n  targetStopId: string,\n  newArrivalDate: string,\n  newDepartureDate: string\n): TripStop[] {\n  const targetIdx = stops.findIndex((s) => s.id === targetStopId);\n  if (targetIdx === -1) return stops;\n\n  const prevStop = targetIdx > 0 ? stops[targetIdx - 1] : null;\n  const clampedArrival =\n    prevStop && newArrivalDate < prevStop.departureDate\n      ? prevStop.departureDate\n      : newArrivalDate;\n\n  const stayNights = Math.max(1, diffDaysIso(clampedArrival, newDepartureDate));\n  const resolvedDeparture = addDaysIso(clampedArrival, stayNights);\n\n  const result = stops.map((s) => ({ ...s }));\n  result[targetIdx] = {\n    ...result[targetIdx],\n    arrivalDate: clampedArrival,\n    departureDate: resolvedDeparture,\n    stayNights,\n  };\n\n  // Sequentially cascade all subsequent stops forward/backward so next.arrival >= prev.departure\n  for (let i = targetIdx + 1; i < result.length; i++) {\n    const prevOld = stops[i - 1];\n    const curOld = stops[i];\n    const originalGap = Math.max(0, diffDaysIso(prevOld.departureDate, curOld.arrivalDate));\n    const prevNew = result[i - 1];\n    const nextArrival = addDaysIso(prevNew.departureDate, originalGap);\n    const nextNights = Math.max(1, curOld.stayNights);\n\n    result[i] = {\n      ...curOld,\n      arrivalDate: nextArrival,\n      departureDate: addDaysIso(nextArrival, nextNights),\n      stayNights: nextNights,\n    };\n  }\n\n  return result;\n}"
          start_line: 58
          end_line: 93
        }
      }
    }
