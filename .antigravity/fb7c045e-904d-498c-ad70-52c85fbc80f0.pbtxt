      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove descriptive paragraphs in VoucherDrawer.tsx.\", \"EndLine\":150, \"Instruction\":\"Keep only promo code, title, savings telemetry, and rule constraints in VoucherDrawer.\", \"ReplacementContent\":\"        <div className=\\\"px-6 py-4 border-b border-neutral-100 flex items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <span className=\\\"w-8 h-8 rounded-xl bg-[#FFF4ED] border border-[#FFD6BA] text-[#E56B1A] flex items-center justify-center\\\">\\n              <Ticket className=\\\"w-4 h-4\\\" />\\n            </span>\\n            <h2 className=\\\"font-display text-lg font-bold text-[#111827]\\\">\\n              Vouchers\\n            </h2>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            aria-label=\\\"Close vouchers panel\\\"\\n            onClick={onClose}\\n            className=\\\"w-8 h-8 rounded-xl flex items-center justify-center text-[#4B5563] hover:text-[#111827] hover:bg-neutral-100 transition-colors cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-6 space-y-5 flex-1 overflow-y-auto astris-scroll\\\">\\n          <form onSubmit={handleSubmit} className=\\\"space-y-2\\\">\\n            <label htmlFor=\\\"promo-code-input\\\" className=\\\"block text-xs font-semibold text-[#111827]\\\">\\n              Promo Code\\n            </label>\\n            <div className=\\\"flex gap-2\\\">\\n              <input\\n                id=\\\"promo-code-input\\\"\\n                type=\\\"text\\\"\\n                value={inputCode}\\n                onChange={(e) => setInputCode(e.target.value.toUpperCase())}\\n                placeholder=\\\"ISTHUB40\\\"\\n                className=\\\"flex-1 px-3.5 py-2.5 rounded-xl border border-neutral-200 font-mono text-sm text-[#111827] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#FF812E]\\\"\\n              />\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={isValidating}\\n                className=\\\"px-4 py-2.5 rounded-xl bg-[#FF812E] hover:bg-[#E56B1A] text-white text-sm font-semibold whitespace-nowrap shrink-0 transition-colors cursor-pointer disabled:opacity-60\\\"\\n              >\\n                {isValidating ? \'Checking...\' : \'Apply\'}\\n              </button>\\n            </div>\\n\\n            {feedback && (\\n              <p\\n                className={`text-xs ${\\n                  feedback.valid ? \'text-[#16A34A]\' : \'text-[#DC2626]\'\\n                }`}\\n              >\\n                {feedback.reason}\\n              </p>\\n            )}\\n          </form>\\n\\n          <div className=\\\"space-y-3\\\">\\n            <h3 className=\\\"text-xs font-semibold text-[#111827]\\\">\\n              Partner Vouchers\\n            </h3>\\n\\n            {vouchers.map((voucher) => {\\n              const isApplied = appliedCodes.includes(voucher.code);\\n              const potentialSavings = getVoucherPotentialSavings(voucher);\\n\\n              return (\\n                <div\\n                  key={voucher.id}\\n                  className={`rounded-2xl p-4 border transition-all ${\\n                    isApplied\\n                      ? \'bg-[#FFF4ED] border-[#FFD6BA]\'\\n                      : \'bg-white border-neutral-200/80\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-3\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <Tag className=\\\"w-3.5 h-3.5 text-[#E56B1A]\\\" />\\n                        <span className=\\\"font-mono text-sm font-bold text-[#111827]\\\">\\n                          {voucher.code}\\n                        </span>\\n                        {potentialSavings > 0 && (\\n                          <span className=\\\"text-xs font-semibold text-[#16A34A] font-mono tabular-nums\\\">\\n                            -${potentialSavings.toFixed(0)}\\n                          </span>\\n                        )}\\n                      </div>\\n                      <div className=\\\"text-sm font-semibold text-[#111827]\\\">\\n                        {voucher.title}\\n                      </div>\\n                      <div className=\\\"text-[11px] text-[#4B5563] font-mono pt-0.5 tabular-nums\\\">\\n                        {voucher.applicableModes.join(\' / \')} \302\267 Min ${voucher.minSpendUsd} \302\267 Exp{\' \'}\\n                        {voucher.expiresAt}\\n                      </div>\\n                    </div>\", \"StartLine\":51, \"TargetContent\":\"        <div className=\\\"px-6 py-4 border-b border-neutral-100 flex items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <span className=\\\"w-8 h-8 rounded-xl bg-[#FFF4ED] border border-[#FFD6BA] text-[#E56B1A] flex items-center justify-center\\\">\\n              <Ticket className=\\\"w-4 h-4\\\" />\\n            </span>\\n            <div>\\n              <h2 className=\\\"font-display text-lg font-bold text-[#111827]\\\">\\n                Voucher &amp; Promo Engine\\n              </h2>\\n              <p className=\\\"text-xs text-[#4B5563]\\\">\\n                Match codes to eligible flights, high-speed rail, and coaches.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            aria-label=\\\"Close vouchers panel\\\"\\n            onClick={onClose}\\n            className=\\\"w-8 h-8 rounded-xl flex items-center justify-center text-[#4B5563] hover:text-[#111827] hover:bg-neutral-100 transition-colors cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-6 space-y-5 flex-1 overflow-y-auto astris-scroll\\\">\\n          <form onSubmit={handleSubmit} className=\\\"space-y-2\\\">\\n            <label htmlFor=\\\"promo-code-input\\\" className=\\\"block text-xs font-semibold text-[#111827]\\\">\\n              Enter Promo Code\\n            </label>\\n            <div className=\\\"flex gap-2\\\">\\n              <input\\n                id=\\\"promo-code-input\\\"\\n                type=\\\"text\\\"\\n                value={inputCode}\\n                onChange={(e) => setInputCode(e.target.value.toUpperCase())}\\n                placeholder=\\\"e.g. ISTHUB40 or COACH10\\\"\\n                className=\\\"flex-1 px-3.5 py-2.5 rounded-xl border border-neutral-200 font-mono text-sm text-[#111827] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#FF812E]\\\"\\n              />\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={isValidating}\\n                className=\\\"px-4 py-2.5 rounded-xl bg-[#FF812E] hover:bg-[#E56B1A] text-white text-sm font-semibold whitespace-nowrap shrink-0 transition-colors cursor-pointer disabled:opacity-60\\\"\\n              >\\n                {isValidating ? \'Checking...\' : \'Apply\'}\\n              </button>\\n            </div>\\n\\n            {feedback && (\\n              <p\\n                className={`text-xs ${\\n                  feedback.valid ? \'text-[#16A34A]\' : \'text-[#DC2626]\'\\n                }`}\\n              >\\n                {feedback.reason}\\n              </p>\\n            )}\\n          </form>\\n\\n          <div className=\\\"space-y-3\\\">\\n            <h3 className=\\\"text-xs font-semibold text-[#111827]\\\">\\n              Available Partner Vouchers\\n            </h3>\\n\\n            {vouchers.map((voucher) => {\\n              const isApplied = appliedCodes.includes(voucher.code);\\n              const potentialSavings = getVoucherPotentialSavings(voucher);\\n\\n              return (\\n                <div\\n                  key={voucher.id}\\n                  className={`rounded-2xl p-4 border transition-all ${\\n                    isApplied\\n                      ? \'bg-[#FFF4ED] border-[#FFD6BA]\'\\n                      : \'bg-white border-neutral-200/80\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-3\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <Tag className=\\\"w-3.5 h-3.5 text-[#E56B1A]\\\" />\\n                        <span className=\\\"font-mono text-sm font-bold text-[#111827]\\\">\\n                          {voucher.code}\\n                        </span>\\n                        {potentialSavings > 0 && (\\n                          <span className=\\\"text-xs font-semibold text-[#16A34A] font-mono tabular-nums\\\">\\n                            Saves ${potentialSavings.toFixed(0)} on current legs\\n                          </span>\\n                        )}\\n                      </div>\\n                      <div className=\\\"text-sm font-semibold text-[#111827]\\\">\\n                        {voucher.title}\\n                      </div>\\n                      <p className=\\\"text-xs text-[#4B5563] leading-relaxed\\\">\\n                        {voucher.description}\\n                      </p>\\n                      <div className=\\\"text-[11px] text-[#4B5563] font-mono pt-0.5\\\">\\n                        Modes: {voucher.applicableModes.join(\', \')} \302\267 Min ${voucher.minSpendUsd} \302\267\\n                        Exp {voucher.expiresAt}\\n                      </div>\\n                    </div>\", \"TargetFile\":\"/src/components/VoucherDrawer.tsx\", \"toolAction\":\"Streamlining VoucherDrawer UI text\", \"toolSummary\":\"Streamline VoucherDrawer.tsx\"}"
