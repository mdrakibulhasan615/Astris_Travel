riceUsd: 46,\\n      doorToDoorNotes: \'Overnight reclining sleeper coach (0.4x comfort weight)\',\\n      co2Kg: 17,\\n      eligibleVoucherIds: [\'v-coach10\'],\\n    }),\\n  ],\\n  \'PAR-LON\': [\\n    makeBaseOption({\\n      id: \'par-lon-es-direct\',\\n      mode: \'train\',\\n      isOvernightSleeper: false,\\n      carrier: \'Eurostar\',\\n      carrierCode: \'ES\',\\n      routeCode: \'ES 9023\',\\n      originStation: \'Paris Gare du Nord\',\\n      destinationStation: \'London St Pancras Intl\',\\n      departureTime: \'11:13\',\\n      arrivalTime: \'12:30\',\\n      inVehicleHours: 2.28,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 122,\\n      doorToDoorNotes: \'City-center to city-center via Channel Tunnel\',\\n      co2Kg: 6,\\n      eligibleVoucherIds: [\'v-railpass20\'],\\n    }),\\n    makeBaseOption({\\n      id: \'par-lon-fx-bus\',\\n      mode: \'bus\',\\n      isOvernightSleeper: false,\\n      carrier: \'FlixBus Cross-Channel\',\\n      carrierCode: \'FX\',\\n      routeCode: \'FX 709\',\\n      originStation: \'Paris Bercy Seine\',\\n      destinationStation: \'London Victoria Coach Stn\',\\n      departureTime: \'09:15\',\\n      arrivalTime: \'17:45\',\\n      inVehicleHours: 8.5,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 39,\\n      doorToDoorNotes: \'Direct coach service with Dover ferry crossing\',\\n      co2Kg: 18,\\n      eligibleVoucherIds: [\'v-coach10\'],\\n    }),\\n  ],\\n  \'IST-PAR\': [\\n    makeBaseOption({\\n      id: \'ist-par-tk-direct\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Turkish Airlines\',\\n      carrierCode: \'TK\',\\n      routeCode: \'TK 1823\',\\n      originStation: \'Istanbul Airport (IST)\',\\n      destinationStation: \'Paris Charles de Gaulle (CDG)\',\\n      departureTime: \'11:15\',\\n      arrivalTime: \'13:55\',\\n      inVehicleHours: 3.67,\\n      layoverHours: 0,\\n      stopsCount: 0,\\n      basePriceUsd: 204,\\n      doorToDoorNotes: \'Nonstop A321neo \302\267 RER B direct to Chatelet-Les Halles\',\\n      co2Kg: 242,\\n      eligibleVoucherIds: [\'v-astris15\', \'v-tkvip40\'],\\n    }),\\n    makeBaseOption({\\n      id: \'ist-par-pc-1stop\',\\n      mode: \'flight\',\\n      isOvernightSleeper: false,\\n      carrier: \'Pegasus Airlines\',\\n      carrierCode: \'PC\',\\n      routeCode: \'PC 1133\',\\n      originStation: \'Sabiha Gokcen (SAW)\',\\n      destinationStation: \'Paris Orly (ORY)\',\\n      departureTime: \'09:40\',\\n      arrivalTime: \'16:10\',\\n      inVehicleHours: 4.1,\\n      layoverHours: 2.4,\\n      layoverHub: \'AYT\',\\n      stopsCount: 1,\\n      basePriceUsd: 146,\\n      doorToDoorNotes: \'1-stop connection via Antalya \302\267 Orlyval metro link\',\\n      co2Kg: 265,\\n      eligibleVoucherIds: [\'v-astris15\'],\\n    }),\\n  ],\\n};\\n\\nexport function createDefaultTrip(): Trip {\\n  const hourlyTimeValue = 15; // Balanced Explorer default ($15/hr)\\n  const appliedVoucherCodes = [\'ASTRIS15\', \'RAIL20\'];\\n  const activeVouchers = VOUCHERS_CATALOG.filter((v) =>\\n    appliedVoucherCodes.includes(v.code)\\n  );\\n\\n  return {\\n    id: \'trip-eurasia-2026\',\\n    title: \'Eurasia Autumn Grand Tour\',\\n    travelers: 1,\\n    currency: \'USD\',\\n    vttsTier: \'explorer\',\\n    hourlyTimeValue,\\n    stops: INITIAL_STOPS,\\n    legs: buildLegsFromStops(\\n      INITIAL_STOPS,\\n      CURATED_CORRIDOR_OPTIONS,\\n      VOUCHERS_CATALOG,\\n      hourlyTimeValue,\\n      activeVouchers\\n    ),\\n    appliedVoucherCodes,\\n  };\\n}\\n\", \"Description\":\"Create realistic JSON mock dataset for Kuala Lumpur -> Istanbul -> London -> Paris trip, curated multi-modal transit corridors, vouchers, and expandable destination hubs.\", \"Overwrite\":true, \"TargetFile\":\"/shared/mockDataset.ts\", \"toolAction\":\"Creating mock 4-stop Eurasia dataset\", \"toolSummary\":\"Create mock dataset\"}"
