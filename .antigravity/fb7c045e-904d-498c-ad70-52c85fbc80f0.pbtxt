;\n                fontWeightClass = \'font-semibold\';\n              }\n\n              return (\n                <button\n                  key={iso}\n                  type=\"button\"\n                  disabled={isBeforePrevStop}\n                  onMouseEnter={() => {\n                    if (draftStartIso && !isBeforePrevStop) setHoverIso(iso);\n                  }}\n                  onClick={() => handleDayClick(iso)}\n                  title={\n                    isBeforePrevStop && prevStopMinArrival\n                      ? `Available from ${formatShortDate(prevStopMinArrival)}`\n                      : alloc\n                        ? `${alloc.stop.city} (${alloc.stop.arrivalDate} \342\206\222 ${alloc.stop.departureDate})`\n                        : iso\n                  }\n                  style={{\n                    backgroundColor: bgStyle,\n                    backgroundImage: bgImageStyle,\n                    color: textColor,\n                    boxShadow: boxShadowStyle,\n                  }}\n                  className={`relative h-9 flex items-center justify-center font-mono text-xs tabular-nums transition-all ${\n                    isBeforePrevStop\n                      ? \'cursor-not-allowed opacity-85\'\n                      : \'cursor-pointer\'\n                  } ${\n                    (isDraftStart || isDraftEnd || (alloc && alloc.stop.id === activeStop?.id && (alloc.isStart || alloc.isEndNight)))\n                      ? \'z-10\'\n                      : \'\'\n                  } ${fontWeightClass} ${pillRadius} ${capSpacingClass} ${\n                    !bgStyle && !bgImageStyle && !isBeforePrevStop ? \'hover:bg-slate-100\' : \'\'\n                  }`}\n                >\n                  {dayNum}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Selection status telemetry */}\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-[#4B5563] 