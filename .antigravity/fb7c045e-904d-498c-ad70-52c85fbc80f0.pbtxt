        target_content: "  // Sync active stop & visible month when opened from a specific stop card\n  useEffect(() => {\n    if (!isOpen) return;\n    const targetId = initialStopId ?? stops[0]?.id ?? \'\';\n    setSelectedStopId(targetId);\n    setDraftStartIso(null);\n    setHoverIso(null);\n    const targetStop = stops.find((s) => s.id === targetId) ?? stops[0];\n    if (targetStop) {\n      const dt = parseIsoUtc(targetStop.arrivalDate);\n      setViewMonth({ year: dt.getUTCFullYear(), month: dt.getUTCMonth() });\n    }\n  }, [isOpen, initialStopId, stops]);"
