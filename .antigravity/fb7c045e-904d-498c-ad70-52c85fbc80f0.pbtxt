            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 1 \342\200\224 Live Express + React Architecture Alongside FastAPI/Pydantic Blueprint**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Serve the interactive React frontend and REST endpoints from a unified Express + Vite Node server on port 3000, while placing clean, production-ready Python FastAPI + Pydantic v2 model definitions and router specs in a dedicated backend reference module."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Ensures the application launches and runs live immediately in the preview environment without requiring a separate Python ASGI runtime, while honoring the exact Pydantic v2 data contracts needed for future Python microservice deployment."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Alternatives Considered*: A static Next.js + FastAPI folder scaffold was passed over because it would leave the port-3000 preview non-functional."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 2 \342\200\224 MapLibre GL (`react-map-gl/maplibre`) + `@turf/great-circle`**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Render the interactive world map with MapLibre GL and free Carto Positron vector/raster styles, drawing smooth spherical great-circle GeoJSON lines and custom HTML numbered markers."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Delivers smooth pan/zoom, `flyTo` synchronization, and crisp curved arcs immediately with zero access-token failures."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Alternatives Considered*: Raw Mapbox GL requires a private token that breaks in tokenless previews; static SVG maps lack real zoom/pan exploration."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 3 \342\200\224 Real-Time Client + Server Smart Score & Two-Stage Optimizer**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Compute interactive Smart Score slider updates instantaneously in client state for zero-latency scrubbing, while routing Two-Stage Route Optimization and Voucher Validation through dedicated Express `/api/*` endpoints."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Gives instant feedback when sliding Hourly Time Value while keeping route-permutation search and promo eligibility cleanly encapsulated in backend APIs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### 4. Technical Architecture & Data Strategy *(Technical Reference)*"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Architecture & Component Diagram**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
