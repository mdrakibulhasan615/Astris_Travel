          target_content: "  // Map each ISO day to the stop whose booked nights cover that date [arrivalDate, departureDate)\n  const dayAllocationMap = useMemo(() => {\n    const map: Record<\n      string,\n      {\n        stop: TripStop;\n        color: string;\n        isStart: boolean;\n        isEndNight: boolean;\n        isCheckoutDay: boolean;\n      }\n    > = {};\n\n    // Populate non-active stops first so the currently selected stop takes visual priority\n    const orderedForPaint = [\n      ...stops.filter((s) => s.id !== activeStop?.id),\n      ...(activeStop ? [activeStop] : []),\n    ];\n\n    for (const stop of orderedForPaint) {\n      const color = stopColorMap[stop.id] ?? \'#FF812E\';\n      const nights = Math.max(1, diffDaysIso(stop.arrivalDate, stop.departureDate));\n      for (let n = 0; n < nights; n++) {\n        const iso = addDaysIso(stop.arrivalDate, n);\n        map[iso] = {\n          stop,\n          color,\n          isStart: n === 0,\n          isEndNight: n === nights - 1,\n          isCheckoutDay: false,\n        };\n      }\n    }\n    return map;\n  }, [stops, activeStop, stopColorMap]);"
          replacement_content: "  const activeStopIndex = activeStop\n    ? stops.findIndex((s) => s.id === activeStop.id)\n    : -1;\n  const prevStopMinArrival =\n    activeStopIndex > 0 ? stops[activeStopIndex - 1].departureDate : null;\n\n  // Map each ISO day to the stop whose booked nights cover that date [arrivalDate, departureDate)\n  // plus any departing stop checking out on the same day for clean split-pill handoff rendering.\n  const { dayAllocationMap, checkoutColorByIso } = useMemo(() => {\n    const map: Record<\n      string,\n      {\n        stop: TripStop;\n        color: string;\n        isStart: boolean;\n        isEndNight: boolean;\n      }\n    > = {};\n    const checkouts: Record<string, string> = {};\n\n    for (const stop of stops) {\n      const color = stopColorMap[stop.id] ?? \'#FF812E\';\n      checkouts[stop.departureDate] = color;\n\n      const nights = Math.max(1, diffDaysIso(stop.arrivalDate, stop.departureDate));\n      for (let n = 0; n < nights; n++) {\n        const iso = addDaysIso(stop.arrivalDate, n);\n        map[iso] = {\n          stop,\n          color,\n          isStart: n === 0,\n          isEndNight: n === nights - 1,\n        };\n      }\n    }\n    return { dayAllocationMap: map, checkoutColorByIso: checkouts };\n  }, [stops, stopColorMap]);"
          start_line: 85
