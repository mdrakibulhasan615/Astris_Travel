    artifact_metadata {
      summary: "Architecture and UX implementation plan for Astris Travel, a split-screen multi-destination travel planning workspace with drag-and-drop timeline synchronization, token-free MapLibre GL geodesic arcs, Smart Score optimization, two-stage global route optimizer, voucher matching, shared TypeScript and FastAPI/Pydantic v2 models, and Express API endpoints backed by a 4-stop Kuala Lumpur to Paris dataset."
      updated_at {
        seconds: 1794582634
        nanos: 456746952
      }
      request_feedback: true
      user_facing: true
    }
    description: "Create implementation plan for Astris Travel covering UX design, architecture, shared models, and interactive split-screen workspace."
