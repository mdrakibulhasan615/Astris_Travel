              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        layover_penalty_usd=layover_penalty,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        total_smart_score=total_score,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "def haversine_km(lat1: float, lng1: float, lat2: float, lng2: float) -> int:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    earth_radius_km = 6371.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    d_lat = math.radians(lat2 - lat1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    d_lng = math.radians(lng2 - lng1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    a = ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        math.sin(d_lat / 2) ** 2"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        + math.cos(math.radians(lat1))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        * math.cos(math.radians(lat2))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        * math.sin(d_lng / 2) ** 2"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return round(earth_radius_km * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a)))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///backend/smart_score.py"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Implement weighted VTTS Smart Score engine and Haversine helper in Python for FastAPI backend."
