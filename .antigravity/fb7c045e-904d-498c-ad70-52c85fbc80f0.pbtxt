={handleToggleVoucher}\\n        onValidateCode={handleValidateVoucherCode}\\n      />\", \"StartLine\":641, \"TargetContent\":\"      <VoucherDrawer\\n        isOpen={isVoucherDrawerOpen}\\n        vouchers={vouchers}\\n        appliedCodes={trip.appliedVoucherCodes}\\n        legs={trip.legs}\\n        onClose={() => setIsVoucherDrawerOpen(false)}\\n        onToggleVoucher={handleToggleVoucher}\\n        onValidateCode={handleValidateVoucherCode}\\n      />\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring date picker in App\", \"toolSummary\":\"Wire date picker in App\"}"
